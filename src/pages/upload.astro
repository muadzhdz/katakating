---
// src/pages/upload.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Upload Catatan"
  description="Unggah catatan praktikum, laporan tugas, atau panduan mandiri mahasiswa Universitas Boash. Mendukung konversi otomatis Word (.docx), PDF Digital (.pdf), Teks (.txt), dan Markdown (.md)."
  currentPath="/upload"
>
  <main class="article-layout" style="max-width: 980px; margin: 32px auto 80px; padding: 0 20px;">
    <!-- BREADCRUMBS -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Upload Catatan</span>
    </nav>

    <!-- PAGE HEADER -->
    <div class="submission-page-header" style="margin-bottom: 24px;">
      <div class="page-eyebrow">// FORMULIR PENGAJUAN NASKAH</div>
      <h1 class="submission-page-title" style="font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--heading); margin: 6px 0 10px; letter-spacing: -0.02em;">
        Upload Catatan &amp; Panduan Praktikum
      </h1>
      <p class="submission-page-subtitle" style="font-size: 13.5px; color: var(--muted); line-height: 1.6; max-width: 720px; margin: 0;">
        Unggah berkas praktikum atau catatan belajar. Terkonversi otomatis ke format repositori.
      </p>
    </div>

    <!-- TEMPLATE CENTER -->
    <section class="template-center-card" aria-label="Template Dokumen">
      <div class="template-center-header-centered">
        <span class="template-dot"></span>
        <span class="template-header-title">// UNDUH BERKAS TEMPLATE</span>
      </div>

      <div class="template-boxes-grid">
        <a href="/templates/template-laporan-praktikum.docx" download class="template-big-box" title="Unduh format Microsoft Word (.docx)">
          <div class="template-big-badge">DOCX</div>
          <div class="template-big-label">Microsoft Word</div>
          <div class="template-big-sub">.docx dokumen</div>
        </a>

        <a href="/templates/template-laporan-praktikum.txt" download class="template-big-box" title="Unduh format Notepad Teks (.txt)">
          <div class="template-big-badge">TXT</div>
          <div class="template-big-label">Notepad Teks</div>
          <div class="template-big-sub">.txt polos</div>
        </a>

        <a href="/templates/template-laporan-praktikum.md" download class="template-big-box" title="Unduh format Markdown (.md)">
          <div class="template-big-badge">MD</div>
          <div class="template-big-label">Markdown</div>
          <div class="template-big-sub">.md naskah</div>
        </a>
      </div>
    </section>

    <!-- UNIVERSAL DROPZONE UNGGAH BERKAS -->
    <div class="submission-dropzone" id="up-dropzone" tabindex="0" role="button" aria-label="Kotak unggah berkas catatan">
      <input type="file" id="up-file-input" class="dropzone-file-input" accept=".docx,.pdf,.txt,.md" />
      <div class="dropzone-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <polyline points="9 15 12 12 15 15"></polyline>
        </svg>
      </div>
      <div class="dropzone-title">Tarik &amp; Lepaskan Berkas ke Sini</div>
      <p class="dropzone-subtitle">
        DOCX, PDF, TXT, MD &bull; Maks. 10 MB
      </p>
      <div class="dropzone-browse-btn" id="btn-browse-file">Pilih Berkas dari Perangkat</div>

      <!-- File Status Badge Inside Dropzone -->
      <div id="file-info-badge" class="file-loaded-badge" style="display: none;">
        <span class="file-badge-icon">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <span class="file-badge-name" id="badge-filename">dokumen.docx</span>
        <span class="file-badge-meta" id="badge-filemeta">Terkonversi Otomatis</span>
        <button type="button" class="file-badge-remove" id="btn-remove-file" aria-label="Hapus berkas">&times;</button>
      </div>

      <!-- Conversion Progress Indicator -->
      <div id="conversion-progress" class="conversion-progress-box" style="display: none;">
        <span class="conv-spinner"></span>
        <span id="conv-msg" style="font-family: var(--mono); font-size: 11.5px; color: var(--accent);">Mengekstrak dan mengonversi isi berkas ke Markdown...</span>
      </div>
    </div>

    <!-- METADATA FORM & EDITOR -->
    <form id="submission-form" class="submission-form-container">
      <div class="form-header-bar" style="display: flex; justify-content: space-between; align-items: center;">
        <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--heading); letter-spacing: 0.05em;">// METADATA</span>
        <span style="font-family: var(--mono); font-size: 10px; color: var(--muted);"><span style="color: #ef4444; font-weight: 700;">*</span> Wajib diisi</span>
      </div>

      <div class="submission-grid-2col">
        <div class="form-group">
          <label class="form-label" for="up-title">Judul Catatan <span style="color: #ef4444;">*</span></label>
          <input type="text" id="up-title" class="form-input" placeholder="Judul catatan praktikum" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="up-category">Kategori <span style="color: #ef4444;">*</span></label>
          <select id="up-category" class="form-select" required>
            <option value="" disabled selected>Pilih Kategori...</option>
            <option value="Jaringan Komputer">Jaringan Komputer</option>
            <option value="Web & Tooling">Web &amp; Tooling</option>
            <option value="Basis Data">Basis Data</option>
            <option value="Algoritma & Pemrograman">Algoritma &amp; Pemrograman</option>
            <option value="IoT & Embedded">IoT &amp; Embedded</option>
            <option value="Game & Multimedia">Game &amp; Multimedia</option>
            <option value="Akademik & Laporan">Akademik &amp; Laporan (4-4-3-3)</option>
            <option value="Git & DevOps">Git &amp; DevOps</option>
          </select>
        </div>
      </div>

      <div class="submission-grid-2col">
        <div class="form-group">
          <label class="form-label" for="up-author">Nama Penulis <span style="color: #ef4444;">*</span></label>
          <input type="text" id="up-author" class="form-input" placeholder="Nama penulis" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="up-nim">NIM <span style="color: #ef4444;">*</span></label>
          <input type="text" id="up-nim" class="form-input" placeholder="NIM / NPM" required />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="up-tags">Tags <span class="form-label-side" style="font-size: 10px; color: var(--muted); font-weight: normal;">(opsional)</span></label>
        <input type="text" id="up-tags" class="form-input" placeholder="networking, vlan, cisco" />
      </div>

      <div class="form-group">
        <label class="form-label" for="up-summary">Ringkasan <span style="color: #ef4444;">*</span></label>
        <textarea id="up-summary" class="form-textarea" rows="3" placeholder="Contoh: Panduan konfigurasi routing RIPv2 dan OSPF pada router Cisco Catalyst untuk modul praktikum Jaringan Komputer semester 4..." required></textarea>
      </div>

      <!-- KONTEN NASKAH (MARKDOWN) & LIVE PREVIEW -->
      <div class="content-preview-container" style="margin-top: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); overflow: hidden;">
        <!-- Header Bar with Mode Toggle -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; background: var(--panel-2); border-bottom: 1px solid var(--line); flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--heading); letter-spacing: 0.05em;">// KONTEN NASKAH (MARKDOWN)</span>
            <span id="preview-mode-tag" class="category-pill" style="font-size: 10px; padding: 2px 6px;">Pratinjau Aktif</span>
          </div>
          <div style="display: flex; gap: 6px;">
            <button type="button" id="tab-btn-preview" class="button" style="min-height: 28px; font-size: 11px; padding: 0 10px; font-family: var(--mono); background: var(--accent); color: var(--bg); font-weight: 700; border-color: var(--accent);">Pratinjau Visual</button>
            <button type="button" id="tab-btn-raw" class="button" style="min-height: 28px; font-size: 11px; padding: 0 10px; font-family: var(--mono);">Editor Markdown</button>
          </div>
        </div>

        <!-- Rendered Visual Preview Pane -->
        <div id="up-preview-pane" style="padding: 20px; min-height: 240px; max-height: 480px; overflow-y: auto;">
          <div id="up-preview-box" class="article-content" style="font-size: 13.5px; line-height: 1.7; color: var(--text);">
            <p style="color: var(--muted); font-family: var(--mono); font-size: 12px; margin: 24px 0; text-align: center;">
              Belum ada berkas dimuat. Tarik &amp; lepaskan berkas Word (.docx), PDF (.pdf), Teks (.txt), atau Markdown (.md) di atas untuk melihat pratinjau otomatis.
            </p>
          </div>
        </div>

        <!-- Raw Markdown Textarea Pane -->
        <div id="up-raw-pane" style="display: none; padding: 12px;">
          <textarea id="up-content" name="content" class="form-textarea" rows="12" style="font-family: var(--mono); font-size: 12.5px; line-height: 1.6; width: 100%; box-sizing: border-box; resize: vertical;" placeholder="# Tulis atau tempel naskah Markdown Anda di sini..."></textarea>
        </div>

        <!-- Footer Stats Bar -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 16px; background: var(--panel-2); border-top: 1px solid var(--line); font-family: var(--mono); font-size: 10.5px; color: var(--muted);">
          <span id="content-status-info">0 karakter &bull; 0 kata</span>
          <span style="color: var(--muted);">Format standar repositori Katakating</span>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
        <button type="submit" id="btn-submit-note" class="button market-primary" style="min-height: 44px; padding: 0 28px; font-weight: 700; font-size: 13.5px;">
          Ajukan &rarr;
        </button>
      </div>
    </form>

    <!-- SUBMISSION RECEIPT MODAL -->
    <div id="submission-modal" class="submission-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="submission-modal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--accent); letter-spacing: 0.05em;">// TIKET PENGAJUAN BERHASIL</span>
          <button type="button" id="modal-close-btn" class="square-action" aria-label="Tutup modal" style="width: 28px; height: 28px;">&times;</button>
        </div>
        <h2 id="modal-title" style="font-size: 20px; font-weight: 700; color: var(--heading); margin-bottom: 8px; letter-spacing: -0.01em;">
          Catatan Berhasil Diajukan!
        </h2>
        <p style="font-size: 13px; color: var(--muted); margin-bottom: 20px; line-height: 1.5;">
          Naskah Anda telah masuk ke sistem antrean kurasi Katakating. Simpan nomor tiket berikut untuk melacak status verifikasi dokumen.
        </p>

        <div class="submission-ticket-box">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: var(--muted);">Nomor Tiket:</span>
            <strong id="modal-ticket-id" style="color: var(--heading); font-family: var(--mono);">-</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: var(--muted);">Waktu Pengajuan:</span>
            <span id="modal-ticket-date" style="font-family: var(--mono);">-</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: var(--muted);">Judul Naskah:</span>
            <span id="modal-ticket-title" style="max-width: 280px; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">-</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--muted);">Penulis:</span>
            <span id="modal-ticket-author">-</span>
          </div>
        </div>

        <button type="button" id="modal-done-btn" class="button market-primary" style="width: 100%; min-height: 42px; font-weight: 700; margin-top: 14px;">
          Selesai &amp; Kembali ke Beranda
        </button>
      </div>
    </div>
  </main>

<!-- Client-side Parsing Engines: Mammoth (.docx), PDF.js (.pdf), Marked.js, DOMPurify (Sanitization) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" defer></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js" defer></script>

<script is:inline>
(function() {
  const dropzone = document.getElementById('up-dropzone');
  const fileInput = document.getElementById('up-file-input');
  const browseBtn = document.getElementById('btn-browse-file');
  const badge = document.getElementById('file-info-badge');
  const badgeName = document.getElementById('badge-filename');
  const badgeMeta = document.getElementById('badge-filemeta');
  const removeBtn = document.getElementById('btn-remove-file');
  const convProgress = document.getElementById('conversion-progress');
  const convMsg = document.getElementById('conv-msg');

  const titleInput = document.getElementById('up-title');
  const categorySelect = document.getElementById('up-category');
  const authorInput = document.getElementById('up-author');
  const nimInput = document.getElementById('up-nim');
  const tagsInput = document.getElementById('up-tags');
  const summaryInput = document.getElementById('up-summary');
  const contentArea = document.getElementById('up-content');
  const previewBox = document.getElementById('up-preview-box');
  const previewPane = document.getElementById('up-preview-pane');
  const rawPane = document.getElementById('up-raw-pane');
  const tabBtnPreview = document.getElementById('tab-btn-preview');
  const tabBtnRaw = document.getElementById('tab-btn-raw');
  const previewModeTag = document.getElementById('preview-mode-tag');
  const statusInfo = document.getElementById('content-status-info');

  const MAX_FILE_SIZE = 15 * 1024 * 1024; // 15 MB
  const ALLOWED_EXTENSIONS = ['docx', 'pdf', 'txt', 'md'];

  // Configure PDF.js worker
  if (window.pdfjsLib) {
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }

  // Pre-fill profile info if logged in
  try {
    const authUser = JSON.parse(localStorage.getItem('katakating_auth_user') || 'null');
    if (authUser) {
      if (authorInput && !authorInput.value && authUser.name) authorInput.value = authUser.name;
      if (nimInput && !nimInput.value && authUser.nim) nimInput.value = authUser.nim;
    }
  } catch (_) {}

  if (browseBtn && fileInput) {
    browseBtn.addEventListener('click', () => fileInput.click());
  }

  function showLoading(msg) {
    if (!convProgress) return;
    convMsg.textContent = msg || 'Mengonversi berkas...';
    convProgress.style.display = 'flex';
  }

  function hideLoading() {
    if (convProgress) convProgress.style.display = 'none';
  }

  // ── XSS Sanitizer Fallback ──
  function sanitizeHtml(html) {
    if (window.DOMPurify && typeof window.DOMPurify.sanitize === 'function') {
      return window.DOMPurify.sanitize(html, {
        ALLOWED_TAGS: [
          'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'blockquote', 'pre', 'code',
          'b', 'strong', 'i', 'em', 'u', 's', 'del', 'ul', 'ol', 'li', 'table',
          'thead', 'tbody', 'tr', 'th', 'td', 'hr', 'br', 'a', 'span', 'div'
        ],
        ALLOWED_ATTR: ['href', 'target', 'rel', 'class', 'id', 'data-lang']
      });
    }
    return html
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
      .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
      .replace(/<embed\b[^<]*(?:(?!<\/embed>)<[^<]*)*<\/embed>/gi, '')
      .replace(/\s+on\w+="[^"]*"/gi, '')
      .replace(/\s+on\w+='[^']*'/gi, '')
      .replace(/javascript:[^"']*/gi, '#');
  }

  function updatePreview(text) {
    if (!text || !text.trim()) {
      if (previewBox) {
        previewBox.innerHTML = '<p style="color: var(--muted); font-family: var(--mono); font-size: 12px; margin: 24px 0; text-align: center;">Belum ada berkas dimuat. Tarik &amp; lepaskan berkas Word (.docx), PDF (.pdf), Teks (.txt), atau Markdown (.md) di atas untuk melihat pratinjau otomatis.</p>';
      }
      if (statusInfo) statusInfo.textContent = '0 karakter • 0 kata';
      return;
    }

    if (previewBox) {
      if (window.marked) {
        const rawHtml = window.marked.parse(text);
        previewBox.innerHTML = sanitizeHtml(rawHtml);
      } else {
        previewBox.textContent = text;
      }
    }

    if (statusInfo) {
      const charCount = text.length;
      const wordCount = (text.trim().match(/\S+/g) || []).length;
      statusInfo.textContent = `${charCount} karakter • ${wordCount} kata`;
    }
  }

  // Tab switching: Visual Preview vs Raw Markdown Editor
  if (tabBtnPreview && tabBtnRaw) {
    tabBtnPreview.addEventListener('click', () => {
      tabBtnPreview.style.background = 'var(--accent)';
      tabBtnPreview.style.color = 'var(--bg)';
      tabBtnPreview.style.fontWeight = '700';
      tabBtnPreview.style.borderColor = 'var(--accent)';

      tabBtnRaw.style.background = '';
      tabBtnRaw.style.color = '';
      tabBtnRaw.style.fontWeight = 'normal';
      tabBtnRaw.style.borderColor = '';

      if (previewPane) previewPane.style.display = 'block';
      if (rawPane) rawPane.style.display = 'none';
      if (previewModeTag) previewModeTag.textContent = 'Pratinjau Aktif';
      updatePreview(contentArea ? contentArea.value : '');
    });

    tabBtnRaw.addEventListener('click', () => {
      tabBtnRaw.style.background = 'var(--accent)';
      tabBtnRaw.style.color = 'var(--bg)';
      tabBtnRaw.style.fontWeight = '700';
      tabBtnRaw.style.borderColor = 'var(--accent)';

      tabBtnPreview.style.background = '';
      tabBtnPreview.style.color = '';
      tabBtnPreview.style.fontWeight = 'normal';
      tabBtnPreview.style.borderColor = '';

      if (previewPane) previewPane.style.display = 'none';
      if (rawPane) rawPane.style.display = 'block';
      if (previewModeTag) previewModeTag.textContent = 'Editor Aktif';
      if (contentArea) contentArea.focus();
    });
  }

  if (contentArea) {
    contentArea.addEventListener('input', () => updatePreview(contentArea.value));
  }

  // ── Universal Metadata Extractor ──
  function extractDocumentMetadata(text) {
    const meta = { title: '', category: '', author: '', nim: '', tags: '', summary: '' };
    const lines = text.split(/\r?\n/);
    const cleanVal = (str) => {
      let s = (str || '').trim();
      s = s.replace(/^["']+|["']+$/g, '').trim();
      if (s.startsWith('[') && s.endsWith(']') && !s.slice(1, -1).includes('[')) {
        s = s.slice(1, -1).trim();
      }
      return s;
    };

    for (const line of lines) {
      const cleanLine = line.replace(/^[#\s*_-]+|[#\s*_-]+$/g, '').trim();
      if (!meta.title) {
        const m = cleanLine.match(/^(?:Judul(?:\s+Catatan|\s+Praktikum|\s+Dokumen|\s+Modul)?|Title):\s*(.+)$/i);
        if (m) meta.title = cleanVal(m[1]);
      }
      if (!meta.category) {
        const m = cleanLine.match(/^(?:Kategori|Category|Bidang):\s*(.+)$/i);
        if (m) meta.category = cleanVal(m[1]);
      }
      if (!meta.author) {
        const m = cleanLine.match(/^(?:Nama(?:\s+Penulis|\s+Lengkap|\s+Mahasiswa)?|Penulis|Author|Disusun\s+Oleh):\s*(.+)$/i);
        if (m) meta.author = cleanVal(m[1]);
      }
      if (!meta.nim) {
        const m = cleanLine.match(/^(?:NIM|NPM|Nomor\s+Induk\s+Mahasiswa):\s*(.+)$/i);
        if (m) meta.nim = cleanVal(m[1]);
      }
      if (!meta.summary) {
        const m = cleanLine.match(/^(?:Ringkasan|Summary|Abstrak|Intisari):\s*(.+)$/i);
        if (m) meta.summary = cleanVal(m[1]);
      }
      if (!meta.tags) {
        const m = cleanLine.match(/^(?:Tags?|Kata\s+Kunci|Label):\s*(.+)$/i);
        if (m) meta.tags = cleanVal(m[1]);
      }
    }

    if (!meta.title) {
      const headings = [];
      for (const line of lines) {
        const hMatch = line.match(/^#{1,3}\s+(.+)$/);
        if (hMatch) {
          const hText = hMatch[1].replace(/^[_\s*#]+|[_\s*#]+$/g, '').trim();
          if (hText) headings.push(hText);
        }
      }
      if (headings.length > 0) {
        const genericRegex = /^(laporan\s+praktikum|universitas\s+boash|modul\s+praktikum|dokumen\s+panduan)/i;
        if (genericRegex.test(headings[0]) && headings.length > 1) {
          meta.title = headings[1];
        } else {
          meta.title = headings[0];
        }
      }
    }
    return meta;
  }

  function applyCategory(rawCat) {
    if (!rawCat || !categorySelect) return;
    const clean = rawCat.toLowerCase().trim();
    for (const opt of categorySelect.options) {
      if (opt.value && (opt.value.toLowerCase() === clean || clean.includes(opt.value.toLowerCase()) || opt.value.toLowerCase().includes(clean))) {
        categorySelect.value = opt.value;
        break;
      }
    }
  }

  // ── Word Document Cleaner ──
  function cleanDocxMarkdown(rawMd) {
    let md = rawMd;
    // Remove double underscores in headings (# __Heading__ -> # Heading)
    md = md.replace(/^(#{1,6}\s+)__([\s\S]*?)__\s*$/gm, '$1$2');
    // Unescape numbered lists (1\. -> 1.)
    md = md.replace(/^(\s*\d+)\\\./gm, '$1.');
    // Unescape brackets
    md = md.replace(/\\\[/g, '[').replace(/\\\]/g, ']');
    // Unescape hyphens
    md = md.replace(/\\-/g, '-');
    // Unescape dots
    md = md.replace(/\\\./g, '.');
    // Consolidate excessive blank lines
    md = md.replace(/\n{3,}/g, '\n\n');
    return md.trim();
  }

  // ── 1. Smart PDF-to-Markdown Parser ──
  async function parsePdf(arrayBuffer) {
    if (!window.pdfjsLib) throw new Error('PDF.js belum termuat di peramban.');
    const loadingTask = window.pdfjsLib.getDocument({ data: arrayBuffer });
    const pdf = await loadingTask.promise;
    let fullMarkdown = '';

    for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
      const page = await pdf.getPage(pageNum);
      const textContent = await page.getTextContent();
      const items = textContent.items;
      if (!items || items.length === 0) continue;

      let lines = [];
      let currentLine = [];
      let lastY = null;
      let maxHeight = 0;

      for (const item of items) {
        if (!item.str || !item.str.trim()) continue;
        const y = Math.round(item.transform[5]);
        const h = Math.round(item.transform[0] || item.height || 12);

        if (lastY !== null && Math.abs(y - lastY) > 5) {
          lines.push({ str: currentLine.join(' '), y: lastY, fontSize: maxHeight });
          currentLine = [];
          maxHeight = 0;
        }
        currentLine.push(item.str.trim());
        lastY = y;
        maxHeight = Math.max(maxHeight, h);
      }
      if (currentLine.length > 0) {
        lines.push({ str: currentLine.join(' '), y: lastY, fontSize: maxHeight });
      }

      let pageMd = '';
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].str;
        const fs = lines[i].fontSize;

        if (fs >= 18) {
          pageMd += `\n# ${line}\n\n`;
        } else if (fs >= 14 || /^(BAB\s+[IVXLCDM]+|TUJUAN|ALAT\s+DAN\s+BAHAN|LANGKAH|HASIL|KESIMPULAN)/i.test(line)) {
          pageMd += `\n## ${line}\n\n`;
        } else if (/^[-*•]\s+/.test(line) || /^\d+\.\s+/.test(line)) {
          pageMd += `${line}\n`;
        } else {
          pageMd += `${line} `;
          if (i < lines.length - 1 && Math.abs(lines[i].y - lines[i + 1].y) > 16) {
            pageMd += '\n\n';
          }
        }
      }

      fullMarkdown += (pdf.numPages > 1 ? `\n<!-- Halaman ${pageNum} -->\n` : '') + pageMd.trim() + '\n\n';
    }

    if (!fullMarkdown.trim()) {
      throw new Error('PDF tidak memiliki teks digital (terbaca sebagai scan gambar). Silakan unggah versi Word atau ketik di editor.');
    }

    const cleanMd = fullMarkdown.trim();
    const meta = extractDocumentMetadata(cleanMd);
    return { markdown: cleanMd, meta };
  }

  // ── 2. Smart Plain Text Normalizer ──
  function normalizeText(text) {
    const rawLines = text.split(/\r?\n/);
    const mdLines = [];

    for (let i = 0; i < rawLines.length; i++) {
      const line = rawLines[i];
      const trim = line.trim();
      if (!trim) {
        mdLines.push('');
        continue;
      }

      // Avoid double divider lines sandwiching section headers
      if (/^[=\-_]{4,}$/.test(trim)) {
        const prevTrim = i > 0 ? rawLines[i - 1].trim() : '';
        const nextTrim = i < rawLines.length - 1 ? rawLines[i + 1].trim() : '';
        if (/^(BAB\s+[IVXLCDM]+|TUJUAN|ALAT|LANGKAH|HASIL|KESIMPULAN|DAFTAR)/i.test(prevTrim) ||
            /^(BAB\s+[IVXLCDM]+|TUJUAN|ALAT|LANGKAH|HASIL|KESIMPULAN|DAFTAR)/i.test(nextTrim)) {
          continue;
        }
        mdLines.push('\n---\n');
        continue;
      }

      if (/^(BAB\s+[IVXLCDM]+.*)/i.test(trim)) {
        mdLines.push(`\n## ${trim}\n`);
      } else if (/^Langkah\s+\d+:/i.test(trim)) {
        mdLines.push(`\n### ${trim}\n`);
      } else if (/^(git\s+|sudo\s+|npm\s+|cargo\s+|python\s+|go\s+|docker\s+)/.test(trim)) {
        mdLines.push('```bash\n' + trim + '\n```');
      } else {
        mdLines.push(line);
      }
    }

    const cleanMd = mdLines.join('\n').replace(/\n{3,}/g, '\n\n').trim();
    const meta = extractDocumentMetadata(text);
    return { markdown: cleanMd, meta };
  }

  // ── 3. Frontmatter & Markdown Parser ──
  function parseMarkdown(md) {
    let title = '';
    let category = '';
    let author = '';
    let nim = '';
    let tags = '';
    let summary = '';
    let body = md;

    const fmMatch = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
    if (fmMatch) {
      const yaml = fmMatch[1];
      body = fmMatch[2];

      const getVal = (k) => {
        const m = yaml.match(new RegExp(`^${k}:\\s*["']?(.*?)["']?\\s*$`, 'm'));
        return m ? m[1].trim() : '';
      };
      title = getVal('title');
      category = getVal('category');
      author = getVal('author');
      nim = getVal('nim');
      summary = getVal('summary');

      const tm = yaml.match(/^tags:\s*\[(.*?)\]/m);
      if (tm) tags = tm[1].replace(/['"]/g, '').trim();
      else tags = getVal('tags');
    }

    const docMeta = extractDocumentMetadata(body);
    if (!title) title = docMeta.title;
    if (!category) category = docMeta.category;
    if (!author) author = docMeta.author;
    if (!nim) nim = docMeta.nim;
    if (!summary) summary = docMeta.summary;
    if (!tags) tags = docMeta.tags;

    return { title, category, author, nim, tags, summary, body: body.trim() };
  }

  // ── 4. Main Universal File Handler ──
  async function handleFile(file) {
    if (!file) return;

    if (file.size === 0) {
      alert('Berkas kosong (0 byte). Harap pilih berkas dokumen yang valid.');
      return;
    }

    if (file.size > MAX_FILE_SIZE) {
      alert(`Ukuran berkas (${(file.size / (1024 * 1024)).toFixed(1)} MB) melebihi batas maksimal 15 MB.`);
      return;
    }

    const ext = (file.name.split('.').pop() || '').toLowerCase();
    if (!ALLOWED_EXTENSIONS.includes(ext)) {
      alert('Format berkas tidak didukung. Harap unggah berkas .docx, .pdf, .txt, atau .md');
      return;
    }

    badgeName.textContent = file.name;
    badgeMeta.textContent = `${(file.size / 1024).toFixed(1)} KB • Memproses...`;
    badge.style.display = 'inline-flex';
    showLoading(`Mengonversi berkas ${ext.toUpperCase()} ke Markdown...`);

    try {
      // 1. DOCX
      if (ext === 'docx') {
        if (!window.mammoth) throw new Error('Mammoth.js belum selesai dimuat.');
        const ab = await file.arrayBuffer();
        const res = await window.mammoth.convertToMarkdown({ arrayBuffer: ab });
        const cleanMd = cleanDocxMarkdown(res.value || '');
        const meta = extractDocumentMetadata(cleanMd);

        if (contentArea) contentArea.value = cleanMd;
        updatePreview(cleanMd);
        badgeMeta.textContent = `${(file.size / 1024).toFixed(1)} KB • Word Terkonversi`;

        if (!titleInput.value && meta.title) titleInput.value = meta.title;
        if (meta.category) applyCategory(meta.category);
        if (!authorInput.value && meta.author) authorInput.value = meta.author;
        if (!nimInput.value && meta.nim) nimInput.value = meta.nim;
        if (!summaryInput.value && meta.summary) summaryInput.value = meta.summary;
        if (!tagsInput.value && meta.tags) tagsInput.value = meta.tags;
      }
      // 2. PDF
      else if (ext === 'pdf') {
        const ab = await file.arrayBuffer();
        const res = await parsePdf(ab);
        if (contentArea) contentArea.value = res.markdown;
        updatePreview(res.markdown);
        badgeMeta.textContent = `${(file.size / 1024).toFixed(1)} KB • PDF Teks Terekstrak`;

        if (!titleInput.value && res.meta.title) titleInput.value = res.meta.title;
        if (res.meta.category) applyCategory(res.meta.category);
        if (!authorInput.value && res.meta.author) authorInput.value = res.meta.author;
        if (!nimInput.value && res.meta.nim) nimInput.value = res.meta.nim;
        if (!summaryInput.value && res.meta.summary) summaryInput.value = res.meta.summary;
      }
      // 3. Markdown (.md)
      else if (ext === 'md') {
        const text = await file.text();
        const parsed = parseMarkdown(text);
        if (contentArea) contentArea.value = parsed.body;
        updatePreview(parsed.body);
        badgeMeta.textContent = `${(file.size / 1024).toFixed(1)} KB • Markdown Siap`;

        if (parsed.title) titleInput.value = parsed.title;
        if (parsed.category) applyCategory(parsed.category);
        if (parsed.author) authorInput.value = parsed.author;
        if (parsed.nim) nimInput.value = parsed.nim;
        if (parsed.tags) tagsInput.value = parsed.tags;
        if (parsed.summary) summaryInput.value = parsed.summary;
      }
      // 4. TXT / Plain Text
      else {
        const text = await file.text();
        const norm = normalizeText(text);
        if (contentArea) contentArea.value = norm.markdown;
        updatePreview(norm.markdown);
        badgeMeta.textContent = `${(file.size / 1024).toFixed(1)} KB • Teks Dirapikan`;

        if (!titleInput.value && norm.meta.title) titleInput.value = norm.meta.title;
        if (norm.meta.category) applyCategory(norm.meta.category);
        if (!authorInput.value && norm.meta.author) authorInput.value = norm.meta.author;
        if (!nimInput.value && norm.meta.nim) nimInput.value = norm.meta.nim;
        if (!summaryInput.value && norm.meta.summary) summaryInput.value = norm.meta.summary;
        if (!tagsInput.value && norm.meta.tags) tagsInput.value = norm.meta.tags;
      }
    } catch (err) {
      alert('Gagal memproses berkas: ' + err.message);
      badgeMeta.textContent = 'Gagal konversi';
    } finally {
      hideLoading();
    }
  }

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) handleFile(e.target.files[0]);
    });
  }

  if (dropzone) {
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });
  }

  if (removeBtn) {
    removeBtn.addEventListener('click', () => {
      fileInput.value = '';
      badge.style.display = 'none';
      if (contentArea) contentArea.value = '';
      updatePreview('');
    });
  }

  // Auto-fill author info from active session
  function autofillAuthor() {
    const auth = window.KataKatingAuth || window.ReadmeAuth;
    if (auth && (auth.profile || auth.user)) {
      const p = auth.profile || {};
      const u = auth.user || {};
      if (authorInput && !authorInput.value) {
        authorInput.value = p.full_name || u.user_metadata?.full_name || '';
      }
      if (nimInput && !nimInput.value && p.nim) {
        nimInput.value = p.nim;
      }
    }
  }
  setTimeout(autofillAuthor, 300);
  window.addEventListener('auth-state-changed', autofillAuthor);

  // ── 5. Submission Form Handling ──
  const form = document.getElementById('submission-form');
  const modal = document.getElementById('submission-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalDoneBtn = document.getElementById('modal-done-btn');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const content = contentArea ? contentArea.value.trim() : '';
      if (!content) {
        alert('Konten naskah catatan masih kosong. Harap unggah berkas dokumen atau ketik naskah pada editor sebelum mengajukan.');
        if (tabBtnRaw) tabBtnRaw.click();
        if (contentArea) contentArea.focus();
        return;
      }

      const ticketId = 'KTK-' + Date.now().toString(36).toUpperCase();
      const nowStr = new Date().toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
      const title = titleInput.value.trim();
      const author = authorInput.value.trim();
      const nim = nimInput.value.trim();
      const category = categorySelect ? categorySelect.value : 'Praktikum';
      const summary = summaryInput ? summaryInput.value.trim() : '';
      const tags = tagsInput ? tagsInput.value.trim().split(/[\s,]+/).filter(Boolean) : [];

      const auth = window.KataKatingAuth || window.ReadmeAuth;
      const sb = auth ? auth.client : null;
      const user = auth ? auth.user : null;

      const subRecord = {
        id: ticketId,
        title: title,
        author_name: author,
        author_npm: nim,
        author_email: (user && user.email) || '',
        category: category,
        summary: summary || (`Pengajuan catatan praktikum oleh ${author} (${nim})`),
        content: content,
        tags: tags,
        status: 'pending_review',
        submitted_at: new Date().toISOString()
      };

      // 1. Save to localStorage for instant local/admin panel review
      try {
        const localSubs = JSON.parse(localStorage.getItem('katakating_submissions') || '[]');
        localSubs.unshift(subRecord);
        localStorage.setItem('katakating_submissions', JSON.stringify(localSubs));
      } catch (err) {
        console.warn('Local submission storage notice:', err);
      }

      // 2. Sync to Supabase if client is ready
      if (sb) {
        try {
          sb.from('submissions').insert({
            title: subRecord.title,
            author_name: subRecord.author_name,
            author_npm: subRecord.author_npm,
            author_email: subRecord.author_email,
            category: subRecord.category,
            summary: subRecord.summary,
            content: subRecord.content,
            status: 'pending_review'
          }).then(() => {}).catch(err => console.warn('Supabase submission insert notice:', err));
        } catch (e) {}
      }

      document.getElementById('modal-ticket-id').textContent = ticketId;
      document.getElementById('modal-ticket-date').textContent = nowStr;
      document.getElementById('modal-ticket-title').textContent = title;
      document.getElementById('modal-ticket-author').textContent = author + ' (' + nim + ')';

      modal.style.display = 'flex';
    });
  }

  if (modalCloseBtn) modalCloseBtn.addEventListener('click', () => modal.style.display = 'none');
  if (modalDoneBtn) modalDoneBtn.addEventListener('click', () => window.location.href = '/');
})();
</script>
</BaseLayout>
