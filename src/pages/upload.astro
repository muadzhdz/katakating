---
// src/pages/upload.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Upload Catatan &amp; Panduan Praktikum — KATAKATING"
  description="Unggah catatan praktikum, laporan tugas, atau panduan mandiri mahasiswa Universitas Boash. Mendukung format Word (.docx), Notepad (.txt), dan Markdown (.md)."
  currentPath="/upload"
>
  <div class="submission-page-wrap">
    <!-- BREADCRUMB -->
    <nav class="submission-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Upload Catatan</span>
    </nav>

    <!-- PAGE HEADER -->
    <div class="submission-page-header" style="margin-bottom: 24px;">
      <div class="page-eyebrow">// UNGGAH CATATAN &bull; UNIVERSITAS BOASH</div>
      <h1 class="submission-page-title">Upload Catatan &amp; Panduan Praktikum</h1>
      <p class="submission-page-subtitle">
        Punya tugas kuliah, laporan praktikum, atau ringkasan materi? Unggah berkas dokumen Anda. Mendukung <b>Microsoft Word (.docx)</b>, <b>Teks (.txt)</b>, dan <b>Markdown (.md)</b> secara otomatis.
      </p>
    </div>

    <!-- STATE 1: AUTH GATE (SHOWN WHEN USER NOT LOGGED IN) -->
    <section id="upload-auth-gate" class="auth-gate-box" style="margin: 24px 0 40px; max-width: 100%;">
      <div class="page-eyebrow" style="margin-bottom: 6px;">// AUTENTIKASI DIBUTUHKAN</div>
      <h2>Silakan Masuk Terlebih Dahulu</h2>
      <p>
        Untuk menjaga orisinalitas naskah dan kualitas repositori bersama, pengunggahan dokumen tugas dan laporan praktikum hanya dapat dilakukan oleh mahasiswa atau admin yang telah masuk ke akun terverifikasi.
      </p>

      <div class="auth-gate-features">
        <div class="auth-gate-feat-item">
          <strong>Data Terverifikasi</strong>
          <span>Nama dan identitas otomatis terhubung ke akun Anda.</span>
        </div>
        <div class="auth-gate-feat-item">
          <strong>Pantau Antrean</strong>
          <span>Status penerbitan dokumen dapat dipantau di akun Anda.</span>
        </div>
        <div class="auth-gate-feat-item">
          <strong>Bebas Spam</strong>
          <span>Melindungi repositori dari pengajuan naskah tanpa identitas.</span>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <button type="button" id="btn-gate-login" class="button market-primary" style="min-height: 42px; padding: 0 24px; font-weight: 700; font-size: 13.5px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Masuk Akun Mahasiswa
        </button>
      </div>
    </section>

    <!-- STATE 2: UPLOAD WORKFLOW (SHOWN WHEN USER IS LOGGED IN) -->
    <section id="upload-content-panel" style="display: none;">
      <!-- UNIVERSAL DROPZONE UNGGAH FILE (.DOCX, .TXT, .MD) -->
      <div class="submission-dropzone" id="up-dropzone" tabindex="0" role="button" aria-label="Kotak unggah berkas catatan">
        <input type="file" id="up-file-input" class="dropzone-file-input" accept=".md,.docx,.txt" />
        <div class="dropzone-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <polyline points="9 15 12 12 15 15"></polyline>
          </svg>
        </div>
        <div class="dropzone-text">
          <span class="dropzone-text-primary">Tarik &amp; Lepaskan Berkas Dokumen ke Sini</span>
          <span class="dropzone-text-secondary">
            Mendukung <b>Microsoft Word (.docx)</b>, <b>Notepad (.txt)</b>, atau <b>Markdown (.md)</b> &bull; Maks. 5 MB
          </span>
        </div>
        <div class="dropzone-browse-btn" id="btn-browse-file">Pilih Berkas</div>
      </div>

      <div id="file-info-badge" class="file-loaded-badge" style="display: none;">
        <span class="file-badge-name" id="badge-filename">catatan.docx</span>
        <button type="button" class="file-badge-remove" id="btn-remove-file" aria-label="Hapus berkas">&times;</button>
      </div>

      <!-- FORM METADATA & EDITOR -->
      <form id="submission-form" class="submission-form">
        <div class="submission-grid-2col">
          <div class="submission-field">
            <label class="submission-label" for="up-title">JUDUL CATATAN *</label>
            <input type="text" id="up-title" class="submission-input" placeholder="cth: Panduan Instalasi Flutter & Android SDK" required />
          </div>

          <div class="submission-field">
            <label class="submission-label" for="up-category">KATEGORI PRAKTIKUM *</label>
            <select id="up-category" class="submission-select" required>
              <option value="" disabled selected>Pilih Kategori...</option>
              <option value="Jaringan Komputer">Jaringan Komputer</option>
              <option value="Web & Tooling">Web &amp; Tooling</option>
              <option value="Basis Data">Basis Data</option>
              <option value="Algoritma & Pemrograman">Algoritma &amp; Pemrograman</option>
              <option value="IoT & Embedded">IoT &amp; Embedded</option>
              <option value="Game & Multimedia">Game &amp; Multimedia</option>
              <option value="Akademik & Laporan">Akademik &amp; Laporan (4-4-3-3)</option>
              <option value="Git & DevOps">Git &amp; DevOps</option>
            </select>
          </div>
        </div>

        <div class="submission-grid-2col">
          <div class="submission-field">
            <label class="submission-label" for="up-author">NAMA PENULIS *</label>
            <input type="text" id="up-author" class="submission-input" placeholder="Nama Lengkap Anda" required />
          </div>

          <div class="submission-field">
            <label class="submission-label" for="up-nim">NIM MAHASISWA *</label>
            <input type="text" id="up-nim" class="submission-input" placeholder="cth: 24903460014" required />
          </div>
        </div>

        <div class="submission-field">
          <label class="submission-label" for="up-tags">TAGS (PISAH DENGAN KOMA)</label>
          <input type="text" id="up-tags" class="submission-input" placeholder="cth: flutter, android, terminal, sdk" />
        </div>

        <div class="submission-field">
          <label class="submission-label" for="up-summary">RINGKASAN INTISARI PRAKTIKUM *</label>
          <textarea id="up-summary" class="submission-textarea" rows="2" placeholder="Tuliskan 1-2 kalimat ringkasan tentang catatan ini..." required></textarea>
        </div>

        <div class="submission-field">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label class="submission-label" for="up-content" style="margin: 0;">ISI KANDUNGAN CATATAN *</label>
            <span style="font-family: var(--mono); font-size: 11px; color: var(--muted);">Format Markdown Terstruktur</span>
          </div>
          <textarea id="up-content" class="submission-textarea" rows="12" placeholder="# Langkah 1&#10;Tuliskan catatan praktikum di sini..." required style="font-family: var(--mono); font-size: 12.5px;"></textarea>
        </div>

        <!-- LIVE PREVIEW CONTAINER -->
        <div style="margin-top: 14px; margin-bottom: 24px;">
          <span class="submission-label">PRATINJAU TAMPILAN (LIVE PREVIEW)</span>
          <div id="up-preview-box" class="article-content" style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; max-height: 380px; overflow-y: auto;">
            <p style="color: var(--muted);">Pratinjau isi catatan akan muncul di sini setelah file diunggah atau teks diketik.</p>
          </div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
          <button type="submit" id="btn-submit-note" class="button market-primary" style="min-height: 42px; padding: 0 24px; font-weight: 700;">
            Ajukan Catatan ke Antrean Moderasi &rarr;
          </button>
        </div>
      </form>
    </section>

    <!-- SUBMISSION RECEIPT MODAL -->
    <div id="submission-modal" class="submission-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="submission-modal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; color: #4ade80;">// TIKET DIAJUKAN BERHASIL</span>
          <button type="button" id="modal-close-btn" class="square-action" aria-label="Tutup modal" style="width: 28px; height: 28px;">&times;</button>
        </div>
        <h2 id="modal-title" style="font-size: 18px; font-weight: 700; color: var(--heading); margin-bottom: 8px;">
          Catatan Berhasil Diajukan!
        </h2>
        <p style="font-size: 13px; color: var(--muted); margin-bottom: 18px; line-height: 1.5;">
          Naskah Anda telah masuk ke sistem antrean moderasi kurasi Katakating. Simpan nomor tiket berikut untuk melacak status verifikasi.
        </p>

        <div style="background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; font-family: var(--mono); font-size: 12px; margin-bottom: 20px; line-height: 1.8;">
          <div><strong>Nomor Tiket:</strong> <span id="modal-ticket-id" style="color: #4ade80; font-weight: 700;">-</span></div>
          <div><strong>Waktu Pengajuan:</strong> <span id="modal-ticket-date">-</span></div>
          <div><strong>Judul Naskah:</strong> <span id="modal-ticket-title">-</span></div>
          <div><strong>Penulis:</strong> <span id="modal-ticket-author">-</span></div>
        </div>

        <button type="button" id="modal-done-btn" class="button market-primary" style="width: 100%; min-height: 40px;">
          Selesai &amp; Kembali ke Beranda
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Mammoth.js for Word .docx conversion in browser -->
<script is:inline src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js"></script>

<script is:inline>
(function() {
  const dropzone = document.getElementById('up-dropzone');
  const fileInput = document.getElementById('up-file-input');
  const browseBtn = document.getElementById('btn-browse-file');
  const badge = document.getElementById('file-info-badge');
  const badgeName = document.getElementById('badge-filename');
  const removeBtn = document.getElementById('btn-remove-file');

  const titleInput = document.getElementById('up-title');
  const contentArea = document.getElementById('up-content');
  const previewBox = document.getElementById('up-preview-box');

  if (browseBtn && fileInput) {
    browseBtn.addEventListener('click', () => fileInput.click());
  }

  function handleFile(file) {
    if (!file) return;
    badgeName.textContent = file.name;
    badge.style.display = 'inline-flex';

    const ext = file.name.split('.').pop().toLowerCase();

    // 1. Word Document (.docx)
    if (ext === 'docx' && window.mammoth) {
      const reader = new FileReader();
      reader.onload = function(loadEvent) {
        const arrayBuffer = loadEvent.target.result;
        window.mammoth.convertToMarkdown({ arrayBuffer: arrayBuffer })
          .then(function(result) {
            const md = result.value || '';
            contentArea.value = md;
            updatePreview(md);

            // Auto-detect title from first line if empty
            if (!titleInput.value) {
              const firstLine = md.split('\n')[0].replace(/^#+\s*/, '').trim();
              if (firstLine) titleInput.value = firstLine;
            }
          })
          .catch(function(err) {
            alert('Gagal membaca berkas Word: ' + err.message);
          });
      };
      reader.readAsArrayBuffer(file);
    }
    // 2. Text File (.txt) or Markdown (.md)
    else {
      const reader = new FileReader();
      reader.onload = function(loadEvent) {
        const text = loadEvent.target.result || '';
        contentArea.value = text;
        updatePreview(text);

        if (!titleInput.value) {
          const firstLine = text.split('\n')[0].replace(/^#+\s*/, '').trim();
          if (firstLine) titleInput.value = firstLine;
        }
      };
      reader.readAsText(file);
    }
  }

  function updatePreview(text) {
    if (!previewBox) return;
    if (window.marked) {
      previewBox.innerHTML = window.marked.parse(text);
    } else {
      previewBox.textContent = text;
    }
  }

  if (contentArea) {
    contentArea.addEventListener('input', () => {
      updatePreview(contentArea.value);
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleFile(e.target.files[0]);
      }
    });
  }

  if (dropzone) {
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('dragover');
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });
  }

  if (removeBtn) {
    removeBtn.addEventListener('click', () => {
      fileInput.value = '';
      badge.style.display = 'none';
    });
  }

  // Submission Form Handling
  const form = document.getElementById('submission-form');
  const modal = document.getElementById('submission-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalDoneBtn = document.getElementById('modal-done-btn');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ticketId = 'SUB-' + Date.now().toString(36).toUpperCase();
      const nowStr = new Date().toLocaleString('id-ID');
      const title = titleInput.value;
      const author = document.getElementById('up-author').value;
      const nim = document.getElementById('up-nim').value;

      document.getElementById('modal-ticket-id').textContent = ticketId;
      document.getElementById('modal-ticket-date').textContent = nowStr;
      document.getElementById('modal-ticket-title').textContent = title;
      document.getElementById('modal-ticket-author').textContent = author + ' (' + nim + ')';

      modal.style.display = 'flex';
    });
  }

  function closeModal() {
    modal.style.display = 'none';
  }
  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if (modalDoneBtn) modalDoneBtn.addEventListener('click', () => {
    window.location.href = '/';
  });
})();
</script>
