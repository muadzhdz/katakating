---
// src/pages/note/[id].astro
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notesPath = path.resolve('./notes/notes.json');
  let notes: any[] = [];
  try {
    notes = JSON.parse(fs.readFileSync(notesPath, 'utf8'));
  } catch (e) {
    notes = [];
  }

  // Fetch approved guides from Cloudflare D1 API so any newly published guides are built statically
  try {
    const API_URL = import.meta.env.PUBLIC_API_URL || process.env.PUBLIC_API_URL || 'https://katakating.pages.dev';
    const res = await fetch(`${API_URL}/api/guides`);
    if (res.ok) {
      const dbGuides = await res.json();
      if (Array.isArray(dbGuides)) {
        for (const g of dbGuides) {
          if (!notes.find((n: any) => n.id === g.id)) {
            notes.push({
              id: g.id,
              title: g.title,
              category: g.category || 'Praktikum',
              author: g.author_name || 'Kontributor Boash',
              date: g.created_at ? g.created_at.split('T')[0] : '2026-10-19',
              readTime: '5 menit',
              initials: g.initials || (g.title ? g.title.substring(0, 4).toUpperCase() : 'DOC'),
              tags: Array.isArray(g.prodi_tags) && g.prodi_tags.length ? g.prodi_tags : ['praktikum'],
              summary: g.summary || g.title,
              rawContent: g.content || '',
            });
          }
        }
      }
    }
  } catch (err) {
    // Gracefully fallback to local notes repository
  }

  // Custom Marked Renderer for Terminal Command Panels and Anchors
  const renderer = new marked.Renderer();

  function escapeHtml(str: string) {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  renderer.code = function({ text, lang }: { text: string; lang?: string }) {
    const cleanLang = (lang || 'sh').toLowerCase();
    return `<div class="command-panel" data-lang="${cleanLang}">
      <div class="command-panel-head">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="display: inline-flex; gap: 4px;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #eab308; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
          </span>
          <span class="command-panel-label">${cleanLang.toUpperCase()}</span>
        </div>
        <button type="button" class="copy-btn" onclick="window.copyCodeSnippet && window.copyCodeSnippet(this)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span>Salin</span>
        </button>
      </div>
      <pre class="code-body"><code>${escapeHtml(text)}</code></pre>
    </div>`;
  };

  renderer.heading = function({ text, depth }: { text: string; depth: number }) {
    if (depth === 2) {
      const slug = text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      return `<h2 id="${slug}">${text}</h2>`;
    }
    return `<h${depth}>${text}</h${depth}>`;
  };

  renderer.blockquote = function({ text }: { text: string }) {
    return `<blockquote class="article-quote">${text}</blockquote>`;
  };

  marked.use({ renderer });

  return notes.map((note: any, index: number) => {
    let mdContent = '';
    if (note.rawContent) {
      mdContent = note.rawContent;
    } else {
      try {
        const filePath = path.resolve('./notes', note.file);
        mdContent = fs.readFileSync(filePath, 'utf8');
        // Strip frontmatter if present
        mdContent = mdContent.replace(/^---[\s\S]*?---/, '').trim();
      } catch (e) {
        mdContent = note.summary || '';
      }
    }

    // Extract table of contents headings (h2)
    const headings: Array<{ text: string; slug: string }> = [];
    const headingRegex = /^##\s+(.+)$/gm;
    let match;
    while ((match = headingRegex.exec(mdContent)) !== null) {
      const rawText = match[1].trim();
      const slug = rawText.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      headings.push({ text: rawText, slug });
    }

    const prevNote = index > 0 ? notes[index - 1] : null;
    const nextNote = index < notes.length - 1 ? notes[index + 1] : null;

    return {
      params: { id: note.id },
      props: {
        note,
        contentHtml: marked.parse(mdContent),
        headings,
        prevNote,
        nextNote,
      },
    };
  });
}

const { note, contentHtml, headings, prevNote, nextNote } = Astro.props;

const canonicalUrl = `https://katakating.vercel.app/note/${note.id}`;
const ogImageUrl = `/og/${note.id}.png`;
---

<BaseLayout
  title={note.title}
  description={note.summary}
  ogImage={ogImageUrl}
  ogType="article"
  canonicalUrl={canonicalUrl}
  currentPath={`/note/${note.id}`}
  keywords={`${note.title}, ${note.category}, ${note.tags.join(', ')}, Boash praktikum`}
>
  <!-- TOP READING PROGRESS BAR -->
  <div id="read-progress-bar" style="position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); width: 0%; z-index: 1003; transition: width 0.1s linear;"></div>

  <div class="article-layout">
    <!-- BREADCRUMBS -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">[>] Beranda</a>
      <span>/</span>
      <a href="/">{note.category}</a>
      <span>/</span>
      <span style="color: var(--accent); font-weight: 600;">{note.initials || 'DOC'}</span>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="article-header">
      <div>
        <span class="page-eyebrow">// {note.category.toUpperCase()} // KODE: {note.id}</span>
      </div>
      <h1 class="article-title">{note.title}</h1>
      
      <div class="article-meta">
        <div class="article-meta-author">Kontributor: <b>{note.author}</b></div>
        <div class="article-meta-details">
          <span>{note.date}</span>
          <span class="article-meta-sep">&bull;</span>
          <span>{note.readTime} baca</span>
          <span class="article-meta-sep">&bull;</span>
          <span id="article-views-counter"><b id="article-views-val">0</b> baca</span>
        </div>
      </div>

      <!-- TAGS -->
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;">
        {note.tags.map((tag: string) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>

      <!-- INTERACTION & TOOLBAR -->
      <div class="article-actions-bar">
        <div class="article-actions-group">
          <!-- Like Button -->
          <button type="button" class="button btn-action-item" id="btn-like-article" data-id={note.id}>
            <svg id="like-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span id="like-text">Suka</span> (<span id="like-count">0</span>)
          </button>

          <!-- Bookmark Button -->
          <button type="button" class="button btn-action-item" id="btn-bookmark-article" data-id={note.id}>
            <svg id="bookmark-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
            <span id="bookmark-text">Simpan</span>
          </button>

          <!-- Share Button -->
          <button type="button" class="button btn-action-item" id="btn-share-article" data-id={note.id} data-title={note.title} data-summary={note.summary}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Bagikan</span>
          </button>

          <!-- Print / Offline Guide -->
          <button type="button" class="button btn-action-item" onclick="window.print()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect width="12" height="8" x="6" y="14"></rect>
            </svg>
            <span>Cetak / PDF</span>
          </button>
        </div>
      </div>
    </header>

    <!-- MAIN ARTICLE BODY (PRE-RENDERED FAST HTML) -->
    <article id="article-body" class="article-content" set:html={contentHtml} />

    <!-- PREV / NEXT ARTICLE NAVIGATION (SINGLE ROW) -->
    <nav class="article-pagination-bar" aria-label="Navigasi Catatan">
      {prevNote ? (
        <a href={`/note/${prevNote.id}`} class="pagination-link prev" title={prevNote.title}>
          <span>&larr;</span> CATATAN SEBELUMNYA
        </a>
      ) : (
        <span class="pagination-link disabled">
          <span>&larr;</span> CATATAN SEBELUMNYA
        </span>
      )}
      <span class="pagination-divider">|</span>
      {nextNote ? (
        <a href={`/note/${nextNote.id}`} class="pagination-link next" title={nextNote.title}>
          CATATAN SELANJUTNYA <span>&rarr;</span>
        </a>
      ) : (
        <span class="pagination-link disabled">
          CATATAN SELANJUTNYA <span>&rarr;</span>
        </span>
      )}
    </nav>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // Reading progress bar
  const progBar = document.getElementById('read-progress-bar');
  if (progBar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const pct = h > 0 ? (window.scrollY / h) * 100 : 0;
      progBar.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }, { passive: true });
  }



  // Global helper for copying code snippets in command panels
  window.copyCodeSnippet = function(button) {
    const panel = button.closest('.command-panel');
    if (!panel) return;
    const codeEl = panel.querySelector('code');
    if (!codeEl) return;
    const codeText = codeEl.innerText;

    navigator.clipboard.writeText(codeText).then(() => {
      const originalHtml = button.innerHTML;
      button.innerHTML = '<span>Tersalin!</span>';
      button.style.borderColor = '#22c55e';
      button.style.color = '#22c55e';
      setTimeout(() => {
        button.innerHTML = originalHtml;
        button.style.borderColor = '';
        button.style.color = '';
      }, 2000);
    });
  };

  // Share Article Button trigger
  const shareBtn = document.getElementById('btn-share-article');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const title = shareBtn.getAttribute('data-title') || document.title;
      const noteId = shareBtn.getAttribute('data-id') || '';
      const summary = shareBtn.getAttribute('data-summary') || '';
      const url = window.location.href;

      if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
    });
  }



  // Like & Bookmark Note Interactivity (Pink Heart & Solid Bookmark)
  const articleId = document.getElementById('btn-like-article')?.getAttribute('data-id') || '';
  const btnLike = document.getElementById('btn-like-article');
  const btnBookmark = document.getElementById('btn-bookmark-article');
  const likeText = document.getElementById('like-text');
  const likeCountEl = document.getElementById('like-count');
  const likeIcon = document.getElementById('like-icon');
  const bookmarkText = document.getElementById('bookmark-text');
  const bookmarkIcon = document.getElementById('bookmark-icon');

  function isValidUuid(id) {
    return typeof id === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);
  }

  async function syncNoteInteractions() {
    if (!articleId) return;
    const auth = window.KataKatingAuth || window.ReadmeAuth;
    const sb = auth ? auth.client : null;
    const user = auth ? auth.user : null;

    let isLiked = !!(localStorage.getItem('katakating_like_' + articleId) || localStorage.getItem('readme_like_' + articleId));
    let isBookmarked = !!(localStorage.getItem('katakating_bookmark_' + articleId) || localStorage.getItem('readme_bookmark_' + articleId));

    try {
      const res = await fetch(`/api/likes?guide_id=${encodeURIComponent(articleId)}`);
      if (res.ok) {
        const data = await res.json();
        if (typeof data.count === 'number' && likeCountEl) likeCountEl.textContent = data.count;
      }
    } catch (e) {}

    function renderUI() {
      if (btnLike && likeIcon && likeText) {
        if (isLiked) {
          btnLike.style.borderColor = '#f43f5e';
          btnLike.style.color = '#f43f5e';
          btnLike.style.background = 'rgba(244, 63, 94, 0.1)';
          likeIcon.style.color = '#f43f5e';
          likeIcon.setAttribute('fill', '#f43f5e');
          likeIcon.setAttribute('stroke', '#f43f5e');
          likeText.textContent = 'Disukai';
        } else {
          btnLike.style.borderColor = '';
          btnLike.style.color = '';
          btnLike.style.background = '';
          likeIcon.style.color = '';
          likeIcon.setAttribute('fill', 'none');
          likeIcon.setAttribute('stroke', 'currentColor');
          likeText.textContent = 'Suka';
        }
      }
      if (btnBookmark && bookmarkIcon && bookmarkText) {
        if (isBookmarked) {
          btnBookmark.style.borderColor = 'var(--accent)';
          btnBookmark.style.color = 'var(--accent)';
          btnBookmark.style.background = 'rgba(255, 255, 255, 0.08)';
          bookmarkIcon.style.color = 'var(--accent)';
          bookmarkIcon.setAttribute('fill', 'currentColor');
          bookmarkText.textContent = 'Tersimpan';
        } else {
          btnBookmark.style.borderColor = '';
          btnBookmark.style.color = '';
          btnBookmark.style.background = '';
          bookmarkIcon.style.color = '';
          bookmarkIcon.setAttribute('fill', 'none');
          bookmarkText.textContent = 'Simpan';
        }
      }
    }
    renderUI();

    if (btnLike) {
      btnLike.onclick = async () => {
        const u = auth ? auth.user : null;
        if (!u) {
          if (auth && auth.openLoginModal) auth.openLoginModal();
          return;
        }
        let curCount = parseInt(likeCountEl ? likeCountEl.textContent : '0', 10) || 0;
        if (isLiked) {
          isLiked = false;
          if (likeCountEl) likeCountEl.textContent = Math.max(0, curCount - 1);
          renderUI();
          try { localStorage.removeItem('katakating_like_' + articleId); } catch(e){}
          if (u && u.id) {
            fetch(`/api/likes?guide_id=${encodeURIComponent(articleId)}&user_id=${encodeURIComponent(u.id)}`, { method: 'DELETE' }).catch(() => {});
          }
        } else {
          isLiked = true;
          if (likeCountEl) likeCountEl.textContent = curCount + 1;
          renderUI();
          try { localStorage.setItem('katakating_like_' + articleId, 'true'); } catch(e){}
          if (u && u.id) {
            fetch('/api/likes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ guide_id: articleId, user_id: u.id })
            }).catch(() => {});
          }
        }
      };
    }

    if (btnBookmark) {
      btnBookmark.onclick = async () => {
        const u = auth ? auth.user : null;
        if (!u) {
          if (auth && auth.openLoginModal) auth.openLoginModal();
          return;
        }
        if (isBookmarked) {
          isBookmarked = false;
          renderUI();
          try { localStorage.removeItem('katakating_bookmark_' + articleId); } catch(e){}
          if (u && u.id) {
            fetch(`/api/bookmarks?guide_id=${encodeURIComponent(articleId)}&user_id=${encodeURIComponent(u.id)}`, { method: 'DELETE' }).catch(() => {});
          }
        } else {
          isBookmarked = true;
          renderUI();
          try { localStorage.setItem('katakating_bookmark_' + articleId, 'true'); } catch(e){}
          if (u && u.id) {
            fetch('/api/bookmarks', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ guide_id: articleId, user_id: u.id })
            }).catch(() => {});
          }
        }
      };
    }
  }

  setTimeout(syncNoteInteractions, 300);
  window.addEventListener('auth-state-changed', syncNoteInteractions);
})();
</script>
