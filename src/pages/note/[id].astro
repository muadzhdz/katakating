---
// src/pages/note/[id].astro
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notesPath = path.resolve('./notes/notes.json');
  const notes = JSON.parse(fs.readFileSync(notesPath, 'utf8'));

  return notes.map((note: any, index: number) => {
    let mdContent = '';
    try {
      const filePath = path.resolve('./notes', note.file);
      mdContent = fs.readFileSync(filePath, 'utf8');
      // Strip frontmatter if present
      mdContent = mdContent.replace(/^---[\s\S]*?---/, '').trim();
    } catch (e) {
      mdContent = note.summary || '';
    }

    const prevNote = index > 0 ? notes[index - 1] : null;
    const nextNote = index < notes.length - 1 ? notes[index + 1] : null;

    return {
      params: { id: note.id },
      props: {
        note,
        contentHtml: marked.parse(mdContent),
        prevNote,
        nextNote,
      },
    };
  });
}

const { note, contentHtml, prevNote, nextNote } = Astro.props;

const canonicalUrl = `https://katakating.vercel.app/note/${note.id}`;
const ogImageUrl = `/og/${note.id}.png`;
---

<BaseLayout
  title={`${note.title} — KATAKATING`}
  description={note.summary}
  ogImage={ogImageUrl}
  ogType="article"
  canonicalUrl={canonicalUrl}
  currentPath={`/note/${note.id}`}
  keywords={`${note.title}, ${note.category}, ${note.tags.join(', ')}, Boash praktikum`}
>
  <!-- READING PROGRESS BAR -->
  <div id="read-progress-bar" style="position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); width: 0%; z-index: 1003; transition: width 0.1s linear;"></div>

  <div class="notes-page-container">
    <!-- BREADCRUMBS -->
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href="/">[>] Beranda</a>
      <span>/</span>
      <a href="/#catalog">{note.category}</a>
      <span>/</span>
      <span style="color: var(--accent);">{note.initials || 'DOC'}</span>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="article-header">
      <div>
        <span class="page-eyebrow">// {note.category.toUpperCase()}</span>
      </div>
      <h1 class="article-title">{note.title}</h1>
      
      <div class="article-meta">
        <span>Penulis: <b>{note.author}</b></span>
        <span>&bull;</span>
        <span>{note.date}</span>
        <span>&bull;</span>
        <span>{note.readTime} baca</span>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;">
        {note.tags.map((tag: string) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>

      <!-- INTERACTION BAR (LIKE, BOOKMARK, SHARE, VIEWS) -->
      <div class="article-actions-bar" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line);">
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <!-- Like Button -->
          <button type="button" class="button" id="btn-like-article" data-id={note.id} style="min-height: 32px; font-size: 11px;">
            <svg id="like-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span id="like-text">Suka</span> (<span id="like-count">0</span>)
          </button>

          <!-- Bookmark Button -->
          <button type="button" class="button" id="btn-bookmark-article" data-id={note.id} style="min-height: 32px; font-size: 11px;">
            <svg id="bookmark-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
            <span id="bookmark-text">Simpan</span>
          </button>

          <!-- Share Button (New!) -->
          <button type="button" class="button" id="btn-share-article" data-id={note.id} data-title={note.title} data-summary={note.summary} style="min-height: 32px; font-size: 11px; background: var(--panel-2); border: 1px solid var(--line-strong);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Bagikan Medsos</span>
          </button>
        </div>

        <div style="font-family: var(--mono); font-size: 11px; color: var(--muted); display: flex; gap: 12px; align-items: center;">
          <span><b id="article-views-val" style="color: var(--heading);">0</b> kali dibaca</span>
        </div>
      </div>
    </header>

    <!-- TL;DR CARD (ANTI-BORING VISUAL SUMMARY) -->
    <div class="tldr-card">
      <div class="tldr-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>INTISARI 30 DETIK (TL;DR)</span>
      </div>
      <p style="font-size: 13.5px; color: var(--heading); font-weight: 500; margin: 0 0 6px;">
        {note.summary}
      </p>
      <ul class="tldr-list">
        <li>Materi teruji langsung pada lingkungan laboratorium praktikum Universitas Boash.</li>
        <li>Format dan prosedur sesuai standar kurikulum akademik terbaru.</li>
        <li>Langkah komputasi dapat dipraktekkan langsung melalui terminal atau editor kode.</li>
      </ul>
    </div>

    <!-- MAIN ARTICLE BODY (PRE-RENDERED FAST HTML) -->
    <article id="article-body" class="article-content" set:html={contentHtml} />

    <!-- CHECKPOINT QUIZ (INTERACTIVE REINFORCEMENT) -->
    <div class="checkpoint-quiz" id="checkpoint-quiz">
      <div class="quiz-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>CHECKPOINT PEMAHAMAN // UJI CEPAT</span>
      </div>
      <p style="font-size: 13.5px; color: var(--heading); margin: 0;">
        Setelah membaca panduan <b>{note.title}</b>, apakah prosedur di atas sudah lu pahami dan berhasil dipraktekkan?
      </p>
      <div class="quiz-options">
        <button type="button" class="quiz-opt-btn" data-answer="correct">
          A. Ya, seluruh alur dan sintaksis kode sudah saya pahami dengan baik.
        </button>
        <button type="button" class="quiz-opt-btn" data-answer="neutral">
          B. Masih perlu membaca ulang dan mencoba simulasi langkah demi langkah.
        </button>
      </div>
      <div id="quiz-feedback" style="display: none; margin-top: 12px; font-family: var(--mono); font-size: 12px; color: #4ade80;">
        ✓ Jawaban tercatat! Selamat melanjutkan eksplorasi catatan praktikum lainnya.
      </div>
    </div>

    <!-- PREV / NEXT ARTICLE NAVIGATION -->
    <nav style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin: 36px 0; padding-top: 24px; border-top: 1px solid var(--line);">
      {prevNote && (
        <a href={`/note/${prevNote.id}`} style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; text-decoration: none; display: flex; flex-direction: column; gap: 4px; transition: all 0.2s;">
          <span style="font-family: var(--mono); font-size: 11px; color: var(--muted);">&larr; CATATAN SEBELUMNYA</span>
          <span style="font-size: 13px; font-weight: 600; color: var(--heading);">{prevNote.title}</span>
        </a>
      )}
      {nextNote && (
        <a href={`/note/${nextNote.id}`} style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; text-decoration: none; display: flex; flex-direction: column; gap: 4px; text-align: right; transition: all 0.2s;">
          <span style="font-family: var(--mono); font-size: 11px; color: var(--muted);">CATATAN BERIKUTNYA &rarr;</span>
          <span style="font-size: 13px; font-weight: 600; color: var(--heading);">{nextNote.title}</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // Reading progress bar
  const progBar = document.getElementById('read-progress-bar');
  if (progBar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const pct = h > 0 ? (window.scrollY / h) * 100 : 0;
      progBar.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }, { passive: true });
  }

  // Share Article Button trigger
  const shareBtn = document.getElementById('btn-share-article');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const title = shareBtn.getAttribute('data-title') || document.title;
      const noteId = shareBtn.getAttribute('data-id') || '';
      const summary = shareBtn.getAttribute('data-summary') || '';
      const url = window.location.href;

      if (navigator.share && window.innerWidth <= 768) {
        navigator.share({
          title: title,
          text: `${title} — ${summary}`,
          url: url
        }).catch(() => {
          if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
        });
      } else {
        if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
      }
    });
  }

  // Quiz checkpoint interaction
  const quizBtns = document.querySelectorAll('.quiz-opt-btn');
  const quizFeedback = document.getElementById('quiz-feedback');
  quizBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      quizBtns.forEach(b => b.classList.remove('correct', 'wrong'));
      btn.classList.add('correct');
      if (quizFeedback) quizFeedback.style.display = 'block';
    });
  });

  // Copy code blocks
  document.querySelectorAll('pre code').forEach(codeBlock => {
    const pre = codeBlock.parentElement;
    if (!pre) return;
    pre.style.position = 'relative';

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'copy-code-btn';
    copyBtn.textContent = 'Salin';
    copyBtn.style.cssText = 'position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #fff; font-family: monospace; font-size: 10.5px; padding: 3px 8px; border-radius: 4px; cursor: pointer;';

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(codeBlock.innerText).then(() => {
        copyBtn.textContent = 'Tersalin!';
        copyBtn.style.background = '#22c55e';
        setTimeout(() => {
          copyBtn.textContent = 'Salin';
          copyBtn.style.background = 'rgba(255,255,255,0.08)';
        }, 2000);
      });
    });

    pre.appendChild(copyBtn);
  });
})();
</script>
