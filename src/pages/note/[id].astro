---
// src/pages/note/[id].astro
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notesPath = path.resolve('./notes/notes.json');
  let notes: any[] = [];
  try {
    notes = JSON.parse(fs.readFileSync(notesPath, 'utf8'));
  } catch (e) {
    notes = [];
  }

  // Fetch approved guides from Cloudflare D1 API so any newly published guides are built statically
  try {
    const API_URL = import.meta.env.PUBLIC_API_URL || process.env.PUBLIC_API_URL || 'https://katakating.pages.dev';
    const res = await fetch(`${API_URL}/api/guides`);
    if (res.ok) {
      const dbGuides = await res.json();
      if (Array.isArray(dbGuides)) {
        for (const g of dbGuides) {
          if (!notes.find((n: any) => n.id === g.id)) {
            const hasLocalFile = fs.existsSync(path.resolve('./notes', `${g.id}.md`));
            const hasContent = g.content && g.content.length > 200 && g.content !== g.summary;
            if (hasLocalFile || hasContent) {
              notes.push({
                id: g.id,
                title: g.title,
                category: g.category || 'Praktikum',
                author: g.author_name || 'Kontributor Boash',
                date: g.created_at ? g.created_at.split('T')[0] : '2026-10-19',
                readTime: '5 menit',
                initials: g.initials || (g.title ? g.title.substring(0, 4).toUpperCase() : 'DOC'),
                tags: Array.isArray(g.prodi_tags) && g.prodi_tags.length ? g.prodi_tags : ['praktikum'],
                summary: g.summary || g.title,
                file: hasLocalFile ? `${g.id}.md` : '',
                rawContent: hasContent ? g.content : '',
              });
            }
          }
        }
      }
    }
  } catch (err) {
    // Gracefully fallback to local notes repository
  }

  // Custom Marked Renderer for Terminal Command Panels and Anchors
  const renderer = new marked.Renderer();

  function escapeHtml(str: string) {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  renderer.code = function({ text, lang }: { text: string; lang?: string }) {
    const cleanLang = (lang || 'sh').toLowerCase();

    // 1. Native Interactive Cyber-Terminal for terminal / console / cli blocks
    if (cleanLang === 'terminal' || cleanLang === 'console' || cleanLang === 'cli') {
      return `<div class="interactive-terminal" data-terminal="true">
        <div class="terminal-bar">
          <div class="terminal-dots">
            <span class="t-dot t-dot-red"></span>
            <span class="t-dot t-dot-yellow"></span>
            <span class="t-dot t-dot-green"></span>
          </div>
          <div class="terminal-title">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            <span>bash &mdash; katakating@boash-lab:~</span>
          </div>
          <div class="terminal-actions">
            <button type="button" class="terminal-action-btn terminal-btn-replay" onclick="window.replayTerminalTyping && window.replayTerminalTyping(this)" title="Simulasikan Ketik Ulang" aria-label="Simulasikan Ketik Ulang">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Ketik Ulang</span>
            </button>
            <button type="button" class="terminal-action-btn copy-btn" onclick="window.copyCodeSnippet && window.copyCodeSnippet(this)" title="Salin Perintah">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span>Salin</span>
            </button>
          </div>
        </div>
        <div class="terminal-screen" data-raw-code="${escapeHtml(text)}">
          <pre class="terminal-code"><code>${escapeHtml(text)}</code></pre>
        </div>
      </div>`;
    }

    // 2. Standard Command Panel with window control dots & 1-click copy
    return `<div class="command-panel" data-lang="${cleanLang}">
      <div class="command-panel-head">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="display: inline-flex; gap: 4px;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #eab308; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
          </span>
          <span class="command-panel-label">${cleanLang.toUpperCase()}</span>
        </div>
        <button type="button" class="copy-btn" onclick="window.copyCodeSnippet && window.copyCodeSnippet(this)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span>Salin</span>
        </button>
      </div>
      <pre class="code-body"><code>${escapeHtml(text)}</code></pre>
    </div>`;
  };

  renderer.heading = function({ text, depth }: { text: string; depth: number }) {
    if (depth === 2) {
      const slug = text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      return `<h2 id="${slug}">${text}</h2>`;
    }
    return `<h${depth}>${text}</h${depth}>`;
  };

  // 3. GitHub & Docusaurus Grade Admonition Callouts Engine
  renderer.blockquote = function({ text }: { text: string }) {
    const alertMatch = text.match(/^\s*(?:<p>)?\s*\[!(KATING|STANDAR|ERROR|WARNING|NOTE|TIP|CAUTION|INFO)\](?:\s*<\/p>|\s*<br\s*\/?>|\n|\r\n)?\s*([\s\S]*)$/i);
    if (!alertMatch) {
      return `<blockquote class="article-quote">${text}</blockquote>`;
    }

    const type = alertMatch[1].toUpperCase();
    let innerHtml = alertMatch[2].replace(/<\/p>\s*$/, '');
    if (!innerHtml.trim().startsWith('<p>')) {
      innerHtml = '<p>' + innerHtml.trim().split(/\n\s*\n/).map((p: string) => p.trim()).filter(Boolean).join('</p><p>') + '</p>';
    }

    let badgeClass = 'admonition-note';
    let title = 'CATATAN TEKNIS // DOKUMENTASI';
    let iconSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';

    if (type === 'KATING' || type === 'TIP') {
      badgeClass = 'admonition-kating';
      title = 'TIPS KATING // SHORTCUT PRAKTIKUM';
      iconSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>';
    } else if (type === 'STANDAR') {
      badgeClass = 'admonition-standar';
      title = 'STANDAR 4-4-3-3 // PEDOMAN LAPORAN TRM';
      iconSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
    } else if (type === 'ERROR' || type === 'WARNING' || type === 'CAUTION') {
      badgeClass = 'admonition-error';
      title = 'PERINGATAN ERROR // ANTISIPASI BUG';
      iconSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
    }

    return `<div class="admonition-callout ${badgeClass}" role="region" aria-label="${title}">
      <div class="admonition-header">
        <span class="admonition-icon">${iconSvg}</span>
        <span class="admonition-title">${title}</span>
      </div>
      <div class="admonition-body">${innerHtml}</div>
    </div>`;
  };

  marked.use({ renderer });

  return notes.map((note: any, index: number) => {
    let mdContent = '';
    if (note.rawContent) {
      mdContent = note.rawContent;
    } else {
      try {
        const filePath = path.resolve('./notes', note.file);
        mdContent = fs.readFileSync(filePath, 'utf8');
        // Strip frontmatter if present
        mdContent = mdContent.replace(/^---[\s\S]*?---/, '').trim();
      } catch (e) {
        mdContent = note.summary || '';
      }
    }

    // Extract table of contents headings (h2)
    const headings: Array<{ text: string; slug: string }> = [];
    const headingRegex = /^##\s+(.+)$/gm;
    let match;
    while ((match = headingRegex.exec(mdContent)) !== null) {
      const rawText = match[1].trim();
      const slug = rawText.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      headings.push({ text: rawText, slug });
    }

    const prevNote = index > 0 ? notes[index - 1] : null;
    const nextNote = index < notes.length - 1 ? notes[index + 1] : null;

    const audioPath = path.resolve('./public/audio', `${note.id}.mp3`);
    const hasAudio = fs.existsSync(audioPath);
    const audioUrl = hasAudio ? `/audio/${note.id}.mp3` : null;

    return {
      params: { id: note.id },
      props: {
        note,
        contentHtml: marked.parse(mdContent),
        headings,
        prevNote,
        nextNote,
        audioUrl,
      },
    };
  });
}

const { note, contentHtml, headings, prevNote, nextNote, audioUrl } = Astro.props;

const canonicalUrl = `https://katakating.pages.dev/note/${note.id}`;
const ogImageUrl = `/og/${note.id}.png`;
---

<BaseLayout
  title={note.title}
  description={note.summary}
  ogImage={ogImageUrl}
  ogType="article"
  canonicalUrl={canonicalUrl}
  currentPath={`/note/${note.id}`}
  keywords={`${note.title}, ${note.category}, ${note.tags.join(', ')}, Boash praktikum`}
>
  <div class="article-layout">
    <!-- BREADCRUMBS -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">[>] Beranda</a>
      <span>/</span>
      <a href="/">{note.category}</a>
      <span>/</span>
      <span style="color: var(--accent); font-weight: 600;">{note.initials || 'DOC'}</span>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="article-header">
      <div>
        <span class="page-eyebrow">// {note.category.toUpperCase()} // KODE: {note.id}</span>
      </div>
      <h1 class="article-title">{note.title}</h1>
      
      <div class="article-meta">
        <div class="article-meta-author">Kontributor: <b>{note.author}</b></div>
        <div class="article-meta-details">
          <span>{note.date}</span>
          <span class="article-meta-sep">&bull;</span>
          <span>{note.readTime} baca</span>
          <span class="article-meta-sep">&bull;</span>
          <span id="article-views-counter"><b id="article-views-val">0</b> baca</span>
        </div>
      </div>

      <!-- TAGS -->
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;">
        {note.tags.map((tag: string) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>

      <!-- INTERACTION & TOOLBAR -->
      <div class="article-actions-bar">
        <div class="article-actions-group">
          <!-- Like Button -->
          <button type="button" class="button btn-action-item" id="btn-like-article" data-id={note.id}>
            <svg id="like-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span id="like-text">Suka</span> (<span id="like-count">0</span>)
          </button>

          <!-- Bookmark Button -->
          <button type="button" class="button btn-action-item" id="btn-bookmark-article" data-id={note.id}>
            <svg id="bookmark-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
            <span id="bookmark-text">Simpan</span>
          </button>

          <!-- Share Button -->
          <button type="button" class="button btn-action-item" id="btn-share-article" data-id={note.id} data-title={note.title} data-summary={note.summary}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Bagikan</span>
          </button>

          <!-- Print / Offline Guide -->
          <button type="button" class="button btn-action-item" onclick="window.print()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect width="12" height="8" x="6" y="14"></rect>
            </svg>
            <span>Cetak / PDF</span>
          </button>

          <!-- Audio Guide Button (Beside Print / Share) -->
          {audioUrl && (
            <button type="button" class="button btn-action-item btn-action-audio" id="btn-toggle-audio-panel" title="Putar Panduan Audio Suara Neural" aria-expanded="false">
              <svg id="action-audio-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
              </svg>
              <span>Audio</span>
              <span id="action-audio-pulse" class="action-audio-pulse-dot" style="display: none;"></span>
            </button>
          )}
        </div>
      </div>
    </header>

    {audioUrl && (
      <aside class="kating-audio-popup" id="kating-audio-popup" aria-label="Pemutar Audio Panduan" style="display: none;">
        <div class="audio-popup-card">
          <!-- POPUP HEADER ROW -->
          <div class="audio-popup-head">
            <div class="audio-popup-title-group">
              <span class="audio-popup-pulse-dot"></span>
              <span class="audio-popup-title">// SUARA NEURAL KATING</span>
            </div>
            <div class="audio-popup-actions">
              <!-- SPEED SELECTOR -->
              <button type="button" class="audio-btn-speed" id="audio-speed-btn" title="Ubah Kecepatan Suara" aria-label="Kecepatan 1.0x">
                <span id="audio-speed-val">1.0x</span>
              </button>
              <!-- CLOSE POPUP BUTTON -->
              <button type="button" class="audio-btn-close" id="audio-popup-close-btn" aria-label="Tutup Panel Audio" title="Tutup Panel Audio">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- NOTE TITLE SUBHEADER -->
          <div class="audio-popup-note-title" title={note.title}>
            {note.title}
          </div>

          <!-- PLAYBACK CONTROLS: -10s, MAIN PLAY/PAUSE, +10s -->
          <div class="audio-controls-row">
            <!-- -10s -->
            <button type="button" class="audio-btn-step" id="audio-step-back" title="Mundur 10 Detik" aria-label="Mundur 10 Detik">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 17l-5-5 5-5M18 17l-5-5 5-5"/>
              </svg>
              <span>-10s</span>
            </button>

            <!-- MAIN PLAY/PAUSE BUTTON -->
            <button type="button" class="audio-btn-main-play" id="audio-play-toggle" aria-label="Putar Panduan Suara">
              <svg class="audio-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="6 4 19 12 6 20 6 4"/>
              </svg>
              <svg class="audio-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                <rect x="6" y="4" width="4" height="16"/>
                <rect x="14" y="4" width="4" height="16"/>
              </svg>
            </button>

            <!-- +10s -->
            <button type="button" class="audio-btn-step" id="audio-step-forward" title="Maju 10 Detik" aria-label="Maju 10 Detik">
              <span>+10s</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 17l5-5-5-5M6 17l5-5-5-5"/>
              </svg>
            </button>
          </div>

          <!-- CUSTOM MODERN SCRUBBER SLIDER (MATCHING SCREENSHOT) -->
          <div class="audio-scrubber-container">
            <div class="audio-scrubber-hitbox" id="audio-scrubber-hitbox" role="slider" aria-label="Posisi Durasi Audio" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
              <div class="audio-scrubber-track">
                <div class="audio-scrubber-played" id="audio-scrubber-played" style="width: 0%;"></div>
                <div class="audio-scrubber-cursor" id="audio-scrubber-cursor" style="left: 0%;"></div>
                <span class="audio-scrubber-end-dot" aria-hidden="true"></span>
              </div>
            </div>
            <div class="audio-time-row">
              <span id="audio-current-time" class="audio-time-text">0:00</span>
              <span id="audio-total-time" class="audio-time-text">--:--</span>
            </div>
          </div>

          <audio id="kating-audio-element" src={audioUrl} preload="metadata"></audio>
        </div>
      </aside>
    )}

    <!-- MAIN ARTICLE BODY (PRE-RENDERED FAST HTML) -->
    <article id="article-body" class="article-content" set:html={contentHtml} />

    <!-- PREV / NEXT ARTICLE NAVIGATION (SINGLE ROW) -->
    <nav class="article-pagination-bar" aria-label="Navigasi Catatan">
      {prevNote ? (
        <a href={`/note/${prevNote.id}`} class="pagination-link prev" title={prevNote.title}>
          <span>&larr;</span> CATATAN SEBELUMNYA
        </a>
      ) : (
        <span class="pagination-link disabled">
          <span>&larr;</span> CATATAN SEBELUMNYA
        </span>
      )}
      <span class="pagination-divider">|</span>
      {nextNote ? (
        <a href={`/note/${nextNote.id}`} class="pagination-link next" title={nextNote.title}>
          CATATAN SELANJUTNYA <span>&rarr;</span>
        </a>
      ) : (
        <span class="pagination-link disabled">
          CATATAN SELANJUTNYA <span>&rarr;</span>
        </span>
      )}
    </nav>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // Global helper for copying code snippets in command panels and interactive terminals
  window.copyCodeSnippet = function(button) {
    const panel = button.closest('.command-panel') || button.closest('.interactive-terminal');
    if (!panel) return;
    const scr = panel.querySelector('.terminal-screen');
    const codeEl = panel.querySelector('code');
    const codeText = scr ? (scr.getAttribute('data-raw-code') || (codeEl ? codeEl.innerText : '')) : (codeEl ? codeEl.innerText : '');
    if (!codeText) return;

    navigator.clipboard.writeText(codeText.trim()).then(() => {
      const originalHtml = button.innerHTML;
      button.innerHTML = '<span>Tersalin!</span>';
      button.style.borderColor = '#22c55e';
      button.style.color = '#22c55e';
      setTimeout(() => {
        button.innerHTML = originalHtml;
        button.style.borderColor = '';
        button.style.color = '';
      }, 2000);
    });
  };

  // Interactive Terminal Simulator Engine
  function escapeHtml(str) {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function runTerminalAnimation(screen, rawText) {
    if (!screen) return;
    screen.dataset.animating = 'true';
    screen.dataset.cancelled = 'false';

    screen.onclick = function() {
      if (screen.dataset.animating === 'true') {
        screen.dataset.cancelled = 'true';
      }
    };

    const lines = rawText.split(/\r?\n/);
    screen.innerHTML = '';
    const pre = document.createElement('pre');
    pre.className = 'terminal-code';
    screen.appendChild(pre);

    let lineIdx = 0;

    function finishAll() {
      screen.dataset.animating = 'false';
      screen.dataset.cancelled = 'false';
      screen.innerHTML = '';
      const finishPre = document.createElement('pre');
      finishPre.className = 'terminal-code';
      lines.forEach((l) => {
        const isCmd = /^[$>]\s/.test(l.trim());
        const isComment = /^#/.test(l.trim());
        const row = document.createElement('div');
        row.className = 'terminal-row';
        if (isCmd) {
          const sym = l.trim().startsWith('$') ? '$' : '>';
          const cmd = l.trim().replace(/^[$>]\s*/, '');
          row.innerHTML = `<span class="terminal-line-prompt">kating@boash-lab:~${sym} </span><span class="terminal-line-cmd">${escapeHtml(cmd)}</span>`;
        } else if (isComment) {
          row.className += ' terminal-line-comment';
          row.textContent = l;
        } else {
          row.className += ' terminal-line-output';
          row.textContent = l;
        }
        finishPre.appendChild(row);
      });
      screen.appendChild(finishPre);
    }

    function processNextLine() {
      if (screen.dataset.cancelled === 'true' || lineIdx >= lines.length) {
        finishAll();
        return;
      }

      const curLine = lines[lineIdx];
      lineIdx++;

      const isCmd = /^[$>]\s/.test(curLine.trim());
      const isComment = /^#/.test(curLine.trim());

      if (isCmd) {
        const sym = curLine.trim().startsWith('$') ? '$' : '>';
        const cmd = curLine.trim().replace(/^[$>]\s*/, '');

        const row = document.createElement('div');
        row.className = 'terminal-row';
        const pSpan = document.createElement('span');
        pSpan.className = 'terminal-line-prompt';
        pSpan.textContent = `kating@boash-lab:~${sym} `;

        const cSpan = document.createElement('span');
        cSpan.className = 'terminal-line-cmd';

        const cursor = document.createElement('span');
        cursor.className = 'terminal-cursor';

        row.appendChild(pSpan);
        row.appendChild(cSpan);
        row.appendChild(cursor);
        pre.appendChild(row);

        let charIdx = 0;
        function typeChar() {
          if (screen.dataset.cancelled === 'true') {
            finishAll();
            return;
          }
          if (charIdx < cmd.length) {
            cSpan.textContent += cmd[charIdx];
            charIdx++;
            setTimeout(typeChar, 20 + Math.random() * 20);
          } else {
            cursor.remove();
            setTimeout(processNextLine, 200);
          }
        }
        typeChar();
      } else if (isComment) {
        const row = document.createElement('div');
        row.className = 'terminal-row terminal-line-comment';
        row.textContent = curLine;
        pre.appendChild(row);
        setTimeout(processNextLine, 100);
      } else {
        const row = document.createElement('div');
        row.className = 'terminal-row terminal-line-output';
        row.textContent = curLine;
        pre.appendChild(row);
        setTimeout(processNextLine, 80);
      }
    }

    processNextLine();
  }

  window.replayTerminalTyping = function(btn) {
    const term = btn.closest('.interactive-terminal');
    if (!term) return;
    const screen = term.querySelector('.terminal-screen');
    if (!screen) return;
    const raw = screen.getAttribute('data-raw-code') || (screen.querySelector('code') ? screen.querySelector('code').textContent : '');
    if (!raw) return;
    runTerminalAnimation(screen, raw);
  };

  function initTerminals() {
    const terms = document.querySelectorAll('.interactive-terminal');
    if (!terms.length) return;
    terms.forEach((t) => {
      const scr = t.querySelector('.terminal-screen');
      if (!scr) return;
      const raw = scr.getAttribute('data-raw-code') || (scr.querySelector('code') ? scr.querySelector('code').textContent : '');
      if (!raw) return;

      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && !t.dataset.played) {
              t.dataset.played = 'true';
              obs.unobserve(t);
              runTerminalAnimation(scr, raw);
            }
          });
        }, { threshold: 0.25 });
        obs.observe(t);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminals);
  } else {
    initTerminals();
  }

  // Share Article Button trigger
  const shareBtn = document.getElementById('btn-share-article');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const title = shareBtn.getAttribute('data-title') || document.title;
      const noteId = shareBtn.getAttribute('data-id') || '';
      const summary = shareBtn.getAttribute('data-summary') || '';
      const url = window.location.href;

      if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
    });
  }



  // Like & Bookmark Note Interactivity (Pink Heart & Solid Bookmark)
  const articleId = document.getElementById('btn-like-article')?.getAttribute('data-id') || '';
  const btnLike = document.getElementById('btn-like-article');
  const btnBookmark = document.getElementById('btn-bookmark-article');
  const likeText = document.getElementById('like-text');
  const likeCountEl = document.getElementById('like-count');
  const likeIcon = document.getElementById('like-icon');
  const bookmarkText = document.getElementById('bookmark-text');
  const bookmarkIcon = document.getElementById('bookmark-icon');

  function isValidUuid(id) {
    return typeof id === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);
  }

  async function syncNoteInteractions() {
    if (!articleId) return;
    const auth = window.KataKatingAuth || window.ReadmeAuth;
    const sb = auth ? auth.client : null;
    const user = auth ? auth.user : null;

    let isLiked = !!(localStorage.getItem('katakating_like_' + articleId) || localStorage.getItem('readme_like_' + articleId));
    let isBookmarked = !!(localStorage.getItem('katakating_bookmark_' + articleId) || localStorage.getItem('readme_bookmark_' + articleId));

    try {
      const res = await fetch(`/api/likes?guide_id=${encodeURIComponent(articleId)}`);
      if (res.ok) {
        const data = await res.json();
        if (typeof data.count === 'number' && likeCountEl) likeCountEl.textContent = data.count;
      }
    } catch (e) {}

    function renderUI() {
      if (btnLike && likeIcon && likeText) {
        if (isLiked) {
          btnLike.style.borderColor = '#f43f5e';
          btnLike.style.color = '#f43f5e';
          btnLike.style.background = 'rgba(244, 63, 94, 0.1)';
          likeIcon.style.color = '#f43f5e';
          likeIcon.setAttribute('fill', '#f43f5e');
          likeIcon.setAttribute('stroke', '#f43f5e');
          likeText.textContent = 'Disukai';
        } else {
          btnLike.style.borderColor = '';
          btnLike.style.color = '';
          btnLike.style.background = '';
          likeIcon.style.color = '';
          likeIcon.setAttribute('fill', 'none');
          likeIcon.setAttribute('stroke', 'currentColor');
          likeText.textContent = 'Suka';
        }
      }
      if (btnBookmark && bookmarkIcon && bookmarkText) {
        if (isBookmarked) {
          btnBookmark.style.borderColor = 'var(--accent)';
          btnBookmark.style.color = 'var(--accent)';
          btnBookmark.style.background = 'rgba(255, 255, 255, 0.08)';
          bookmarkIcon.style.color = 'var(--accent)';
          bookmarkIcon.setAttribute('fill', 'currentColor');
          bookmarkText.textContent = 'Tersimpan';
        } else {
          btnBookmark.style.borderColor = '';
          btnBookmark.style.color = '';
          btnBookmark.style.background = '';
          bookmarkIcon.style.color = '';
          bookmarkIcon.setAttribute('fill', 'none');
          bookmarkText.textContent = 'Simpan';
        }
      }
    }
    renderUI();

    if (btnLike) {
      btnLike.onclick = async () => {
        const u = auth ? auth.user : null;
        if (!u) {
          if (auth && auth.openLoginModal) auth.openLoginModal();
          return;
        }
        let curCount = parseInt(likeCountEl ? likeCountEl.textContent : '0', 10) || 0;
        if (isLiked) {
          isLiked = false;
          if (likeCountEl) likeCountEl.textContent = Math.max(0, curCount - 1);
          renderUI();
          try { localStorage.removeItem('katakating_like_' + articleId); } catch(e){}
          if (u && u.id) {
            fetch(`/api/likes?guide_id=${encodeURIComponent(articleId)}&user_id=${encodeURIComponent(u.id)}`, { method: 'DELETE' }).catch(() => {});
          }
        } else {
          isLiked = true;
          if (likeCountEl) likeCountEl.textContent = curCount + 1;
          renderUI();
          try { localStorage.setItem('katakating_like_' + articleId, 'true'); } catch(e){}
          if (u && u.id) {
            fetch('/api/likes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ guide_id: articleId, user_id: u.id })
            }).catch(() => {});
          }
        }
      };
    }

    if (btnBookmark) {
      btnBookmark.onclick = async () => {
        const u = auth ? auth.user : null;
        if (!u) {
          if (auth && auth.openLoginModal) auth.openLoginModal();
          return;
        }
        if (isBookmarked) {
          isBookmarked = false;
          renderUI();
          try { localStorage.removeItem('katakating_bookmark_' + articleId); } catch(e){}
          if (u && u.id) {
            fetch(`/api/bookmarks?guide_id=${encodeURIComponent(articleId)}&user_id=${encodeURIComponent(u.id)}`, { method: 'DELETE' }).catch(() => {});
          }
        } else {
          isBookmarked = true;
          renderUI();
          try { localStorage.setItem('katakating_bookmark_' + articleId, 'true'); } catch(e){}
          if (u && u.id) {
            fetch('/api/bookmarks', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ guide_id: articleId, user_id: u.id })
            }).catch(() => {});
          }
        }
      };
    }
  }

  // AI Neural Audio Popup Player Controller
  const audioEl = document.getElementById('kating-audio-element');
  const btnTogglePanel = document.getElementById('btn-toggle-audio-panel');
  const audioPopup = document.getElementById('kating-audio-popup');
  const btnClosePopup = document.getElementById('audio-popup-close-btn');
  const audioPulse = document.getElementById('action-audio-pulse');
  const playBtn = document.getElementById('audio-play-toggle');
  const playIcon = playBtn ? playBtn.querySelector('.audio-icon-play') : null;
  const pauseIcon = playBtn ? playBtn.querySelector('.audio-icon-pause') : null;
  const stepBackBtn = document.getElementById('audio-step-back');
  const stepForwardBtn = document.getElementById('audio-step-forward');
  const scrubberHitbox = document.getElementById('audio-scrubber-hitbox');
  const scrubberPlayed = document.getElementById('audio-scrubber-played');
  const scrubberCursor = document.getElementById('audio-scrubber-cursor');
  const currTimeEl = document.getElementById('audio-current-time');
  const totalTimeEl = document.getElementById('audio-total-time');
  const speedBtn = document.getElementById('audio-speed-btn');
  const speedVal = document.getElementById('audio-speed-val');

  if (audioEl && scrubberHitbox) {
    let isDragging = false;

    function formatTime(sec) {
      if (!sec || isNaN(sec) || sec < 0) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    function setPlayState(isPlaying) {
      if (isPlaying) {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'inline-block';
        if (audioPulse) audioPulse.style.display = 'inline-block';
        if (btnTogglePanel) btnTogglePanel.classList.add('audio-active-playing');
      } else {
        if (playIcon) playIcon.style.display = 'inline-block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (audioPulse) audioPulse.style.display = 'none';
        if (btnTogglePanel) btnTogglePanel.classList.remove('audio-active-playing');
      }
    }

    function updateScrubberUI(pct) {
      const clamped = Math.max(0, Math.min(100, pct));
      if (scrubberPlayed) scrubberPlayed.style.width = clamped + '%';
      if (scrubberCursor) scrubberCursor.style.left = clamped + '%';
      if (scrubberHitbox) scrubberHitbox.setAttribute('aria-valuenow', clamped.toFixed(1));
    }

    function getPctFromEvent(e) {
      const rect = scrubberHitbox.getBoundingClientRect();
      const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
      const x = clientX - rect.left;
      return Math.max(0, Math.min(100, (x / rect.width) * 100));
    }

    function handleSeek(e, commit = false) {
      if (!audioEl.duration) return;
      const pct = getPctFromEvent(e);
      updateScrubberUI(pct);
      const targetTime = (pct / 100) * audioEl.duration;
      if (currTimeEl) currTimeEl.textContent = formatTime(targetTime);
      if (commit) {
        audioEl.currentTime = targetTime;
      }
    }

    // Popup Open / Close Actions
    function openPopup() {
      if (!audioPopup) return;
      audioPopup.style.display = 'block';
      // Trigger CSS transition
      requestAnimationFrame(() => {
        audioPopup.classList.add('audio-popup-visible');
      });
      if (btnTogglePanel) {
        btnTogglePanel.setAttribute('aria-expanded', 'true');
        btnTogglePanel.classList.add('active');
      }
    }

    function closePopup() {
      if (!audioPopup) return;
      audioPopup.classList.remove('audio-popup-visible');
      setTimeout(() => {
        if (!audioPopup.classList.contains('audio-popup-visible')) {
          audioPopup.style.display = 'none';
        }
      }, 240);
      if (btnTogglePanel) {
        btnTogglePanel.setAttribute('aria-expanded', 'false');
        btnTogglePanel.classList.remove('active');
      }
    }

    if (btnTogglePanel) {
      btnTogglePanel.addEventListener('click', () => {
        const isOpen = audioPopup && audioPopup.classList.contains('audio-popup-visible');
        if (isOpen) {
          closePopup();
        } else {
          openPopup();
          if (audioEl.paused) {
            audioEl.play().then(() => setPlayState(true)).catch(() => {});
          }
        }
      });
    }

    if (btnClosePopup) {
      btnClosePopup.addEventListener('click', closePopup);
    }

    // Audio Metadata & Time Update
    audioEl.addEventListener('loadedmetadata', () => {
      if (totalTimeEl) totalTimeEl.textContent = formatTime(audioEl.duration);
    });

    audioEl.addEventListener('timeupdate', () => {
      if (!isDragging && audioEl.duration) {
        const pct = (audioEl.currentTime / audioEl.duration) * 100;
        updateScrubberUI(pct);
        if (currTimeEl) currTimeEl.textContent = formatTime(audioEl.currentTime);
      }
    });

    audioEl.addEventListener('ended', () => {
      setPlayState(false);
      updateScrubberUI(0);
      if (currTimeEl) currTimeEl.textContent = '0:00';
    });

    // Play / Pause Button
    if (playBtn) {
      playBtn.addEventListener('click', () => {
        if (audioEl.paused) {
          audioEl.play().then(() => setPlayState(true)).catch(() => {});
        } else {
          audioEl.pause();
          setPlayState(false);
        }
      });
    }

    // Step -10s and +10s
    if (stepBackBtn) {
      stepBackBtn.addEventListener('click', () => {
        audioEl.currentTime = Math.max(0, audioEl.currentTime - 10);
      });
    }

    if (stepForwardBtn) {
      stepForwardBtn.addEventListener('click', () => {
        if (audioEl.duration) {
          audioEl.currentTime = Math.min(audioEl.duration, audioEl.currentTime + 10);
        }
      });
    }

    // Interactive Drag & Seek Scrubber (Desktop Mouse)
    scrubberHitbox.addEventListener('mousedown', (e) => {
      isDragging = true;
      handleSeek(e, false);

      const onMouseMove = (ev) => {
        if (isDragging) handleSeek(ev, false);
      };

      const onMouseUp = (ev) => {
        if (isDragging) {
          isDragging = false;
          handleSeek(ev, true);
        }
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
      };

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    });

    // Interactive Drag & Seek Scrubber (Mobile Touch)
    scrubberHitbox.addEventListener('touchstart', (e) => {
      isDragging = true;
      handleSeek(e, false);
    }, { passive: true });

    scrubberHitbox.addEventListener('touchmove', (e) => {
      if (isDragging) handleSeek(e, false);
    }, { passive: true });

    scrubberHitbox.addEventListener('touchend', (e) => {
      if (isDragging) {
        isDragging = false;
        const clientX = e.changedTouches && e.changedTouches.length > 0 ? e.changedTouches[0].clientX : null;
        if (clientX !== null && audioEl.duration) {
          const rect = scrubberHitbox.getBoundingClientRect();
          const pct = Math.max(0, Math.min(100, ((clientX - rect.left) / rect.width) * 100));
          audioEl.currentTime = (pct / 100) * audioEl.duration;
        }
      }
    });

    // Scrubber Keyboard Accessibility
    scrubberHitbox.addEventListener('keydown', (e) => {
      if (!audioEl.duration) return;
      if (e.key === 'ArrowLeft') {
        audioEl.currentTime = Math.max(0, audioEl.currentTime - 5);
      } else if (e.key === 'ArrowRight') {
        audioEl.currentTime = Math.min(audioEl.duration, audioEl.currentTime + 5);
      }
    });

    // Playback Speed Toggle (1.0x -> 1.25x -> 1.5x -> 2.0x)
    const speeds = [1.0, 1.25, 1.5, 2.0];
    let speedIdx = 0;
    if (speedBtn) {
      speedBtn.addEventListener('click', () => {
        speedIdx = (speedIdx + 1) % speeds.length;
        const s = speeds[speedIdx];
        audioEl.playbackRate = s;
        if (speedVal) speedVal.textContent = s.toFixed(1) + 'x';
        speedBtn.setAttribute('aria-label', 'Kecepatan ' + s + 'x');
      });
    }
  }

  setTimeout(syncNoteInteractions, 300);
  window.addEventListener('auth-state-changed', syncNoteInteractions);
})();
</script>
