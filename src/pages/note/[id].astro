---
// src/pages/note/[id].astro
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notesPath = path.resolve('./notes/notes.json');
  const notes = JSON.parse(fs.readFileSync(notesPath, 'utf8'));

  // Custom Marked Renderer for Terminal Command Panels and Anchors
  const renderer = new marked.Renderer();

  function escapeHtml(str: string) {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  renderer.code = function({ text, lang }: { text: string; lang?: string }) {
    const cleanLang = (lang || 'sh').toLowerCase();
    return `<div class="command-panel" data-lang="${cleanLang}">
      <div class="command-panel-head">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="display: inline-flex; gap: 4px;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #eab308; display: inline-block;"></span>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
          </span>
          <span class="command-panel-label">${cleanLang.toUpperCase()}</span>
        </div>
        <button type="button" class="copy-btn" onclick="window.copyCodeSnippet && window.copyCodeSnippet(this)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span>Salin</span>
        </button>
      </div>
      <pre class="code-body"><code>${escapeHtml(text)}</code></pre>
    </div>`;
  };

  renderer.heading = function({ text, depth }: { text: string; depth: number }) {
    if (depth === 2) {
      const slug = text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      return `<h2 id="${slug}">${text} <a href="#${slug}" class="heading-anchor" title="Tautan bagian">#</a></h2>`;
    }
    return `<h${depth}>${text}</h${depth}>`;
  };

  renderer.blockquote = function({ text }: { text: string }) {
    return `<blockquote class="article-quote">${text}</blockquote>`;
  };

  marked.use({ renderer });

  return notes.map((note: any, index: number) => {
    let mdContent = '';
    try {
      const filePath = path.resolve('./notes', note.file);
      mdContent = fs.readFileSync(filePath, 'utf8');
      // Strip frontmatter if present
      mdContent = mdContent.replace(/^---[\s\S]*?---/, '').trim();
    } catch (e) {
      mdContent = note.summary || '';
    }

    // Extract table of contents headings (h2)
    const headings: Array<{ text: string; slug: string }> = [];
    const headingRegex = /^##\s+(.+)$/gm;
    let match;
    while ((match = headingRegex.exec(mdContent)) !== null) {
      const rawText = match[1].trim();
      const slug = rawText.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      headings.push({ text: rawText, slug });
    }

    const prevNote = index > 0 ? notes[index - 1] : null;
    const nextNote = index < notes.length - 1 ? notes[index + 1] : null;

    return {
      params: { id: note.id },
      props: {
        note,
        contentHtml: marked.parse(mdContent),
        headings,
        prevNote,
        nextNote,
      },
    };
  });
}

const { note, contentHtml, headings, prevNote, nextNote } = Astro.props;

const canonicalUrl = `https://katakating.vercel.app/note/${note.id}`;
const ogImageUrl = `/og/${note.id}.png`;
---

<BaseLayout
  title={`${note.title} — KATAKATING`}
  description={note.summary}
  ogImage={ogImageUrl}
  ogType="article"
  canonicalUrl={canonicalUrl}
  currentPath={`/note/${note.id}`}
  keywords={`${note.title}, ${note.category}, ${note.tags.join(', ')}, Boash praktikum`}
>
  <!-- TOP READING PROGRESS BAR -->
  <div id="read-progress-bar" style="position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); width: 0%; z-index: 1003; transition: width 0.1s linear;"></div>

  <div class="article-layout">
    <!-- BREADCRUMBS -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">[>] Beranda</a>
      <span>/</span>
      <a href="/#catalog">{note.category}</a>
      <span>/</span>
      <span style="color: var(--accent); font-weight: 600;">{note.initials || 'DOC'}</span>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="article-header">
      <div>
        <span class="page-eyebrow">// {note.category.toUpperCase()} // KODE: {note.id}</span>
      </div>
      <h1 class="article-title">{note.title}</h1>
      
      <div class="article-meta">
        <span>Kontributor: <b>{note.author}</b></span>
        <span>&bull;</span>
        <span>{note.date}</span>
        <span>&bull;</span>
        <span>{note.readTime} baca</span>
        <span>&bull;</span>
        <span id="article-views-counter"><b id="article-views-val">0</b> baca</span>
      </div>

      <!-- TAGS -->
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;">
        {note.tags.map((tag: string) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>

      <!-- INTERACTION & TOOLBAR -->
      <div class="article-actions-bar" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line);">
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
          <!-- Like Button -->
          <button type="button" class="button" id="btn-like-article" data-id={note.id} style="min-height: 32px; font-size: 11px;">
            <svg id="like-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span id="like-text">Suka</span> (<span id="like-count">0</span>)
          </button>

          <!-- Bookmark Button -->
          <button type="button" class="button" id="btn-bookmark-article" data-id={note.id} style="min-height: 32px; font-size: 11px;">
            <svg id="bookmark-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
            <span id="bookmark-text">Simpan</span>
          </button>

          <!-- Share Button -->
          <button type="button" class="button" id="btn-share-article" data-id={note.id} data-title={note.title} data-summary={note.summary} style="min-height: 32px; font-size: 11px; background: var(--panel-2); border: 1px solid var(--line-strong);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Bagikan</span>
          </button>

          <!-- Print / Offline Guide -->
          <button type="button" class="button" onclick="window.print()" style="min-height: 32px; font-size: 11px; background: transparent; border: 1px solid var(--line);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect width="12" height="8" x="6" y="14"></rect>
            </svg>
            <span>Cetak / PDF</span>
          </button>
        </div>

        <!-- Quick In-Article Font Size Scaler -->
        <div style="display: flex; align-items: center; gap: 4px; font-family: var(--mono); font-size: 11px; background: var(--panel-2); padding: 3px 6px; border-radius: var(--radius); border: 1px solid var(--line);">
          <span style="color: var(--muted); margin-right: 4px;">Ukuran:</span>
          <button type="button" class="font-scaler-btn" data-scale="compact" style="background: none; border: none; color: var(--muted); cursor: pointer; padding: 2px 4px; font-family: var(--mono); font-size: 11px;">A-</button>
          <span style="color: var(--line);">|</span>
          <button type="button" class="font-scaler-btn active" data-scale="normal" style="background: none; border: none; color: var(--heading); cursor: pointer; padding: 2px 4px; font-family: var(--mono); font-size: 11px; font-weight: 700;">A</button>
          <span style="color: var(--line);">|</span>
          <button type="button" class="font-scaler-btn" data-scale="large" style="background: none; border: none; color: var(--muted); cursor: pointer; padding: 2px 4px; font-family: var(--mono); font-size: 11px;">A+</button>
        </div>
      </div>
    </header>

    <!-- TL;DR SUMMARY CARD -->
    <div class="tldr-card">
      <div class="tldr-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>INTISARI 30 DETIK (TL;DR)</span>
      </div>
      <p style="font-size: 13.5px; color: var(--heading); font-weight: 500; margin: 0 0 8px; line-height: 1.5;">
        {note.summary}
      </p>
      <ul class="tldr-list">
        <li>Materi divalidasi dan teruji langsung di laboratorium praktikum Universitas Boash.</li>
        <li>Format dan prosedur penulisan naskah selaras standar kurikulum akademik.</li>
        <li>Semua langkah konfigurasi dan sintaksis kode dapat langsung disalin ke terminal.</li>
      </ul>
    </div>

    <!-- TABLE OF CONTENTS (TOC) PILLS (IF HEADINGS EXIST) -->
    {headings && headings.length > 0 && (
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; margin-bottom: 28px;">
        <div style="font-family: var(--mono); font-size: 10.5px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
          <span>// LOMPAT KE SUB-MATERI:</span>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          {headings.map(h => (
            <a href={`#${h.slug}`} style="font-family: var(--mono); font-size: 11.5px; color: var(--text); background: var(--panel-2); border: 1px solid var(--line); padding: 4px 10px; border-radius: var(--radius); text-decoration: none; transition: all 0.15s ease;">
              {h.text}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- MAIN ARTICLE BODY (PRE-RENDERED FAST HTML) -->
    <article id="article-body" class="article-content" set:html={contentHtml} />

    <!-- CHECKPOINT QUIZ (INTERACTIVE RETENTION) -->
    <div class="checkpoint-quiz" id="checkpoint-quiz">
      <div class="quiz-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>CHECKPOINT PEMAHAMAN // UJI CEPAT</span>
      </div>
      <p style="font-size: 13.5px; color: var(--heading); margin: 0 0 12px; line-height: 1.5;">
        Setelah mempraktikkan panduan <b>{note.title}</b>, apakah langkah-langkah di atas sudah berhasil dieksekusi di workstation lu?
      </p>
      <div class="quiz-options">
        <button type="button" class="quiz-opt-btn" data-answer="correct">
          A. Berhasil 100%, konfigurasi/kode berjalan sesuai yang diharapkan di workstation saya.
        </button>
        <button type="button" class="quiz-opt-btn" data-answer="neutral">
          B. Masih mengalami kendala dependensi atau error yang perlu dicari solusinya lebih lanjut.
        </button>
      </div>
      <div id="quiz-feedback" style="display: none; margin-top: 14px; font-family: var(--mono); font-size: 12px; color: #4ade80; background: rgba(74,222,128,0.08); border: 1px solid rgba(74,222,128,0.25); padding: 10px 14px; border-radius: var(--radius);">
        ✓ Catatan interaktif tersimpan! Jika butuh bantuan lebih lanjut, lu bisa menanyakan di forum lab atau request pembahasan lanjutan di tombol request.
      </div>
    </div>

    <!-- PREV / NEXT ARTICLE NAVIGATION -->
    <nav style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin: 36px 0; padding-top: 24px; border-top: 1px solid var(--line);">
      {prevNote && (
        <a href={`/note/${prevNote.id}`} style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; text-decoration: none; display: flex; flex-direction: column; gap: 6px; transition: all 0.2s;">
          <span style="font-family: var(--mono); font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 4px;">
            <span>&larr;</span> CATATAN SEBELUMNYA
          </span>
          <span style="font-size: 13.5px; font-weight: 700; color: var(--heading); line-height: 1.4;">{prevNote.title}</span>
        </a>
      )}
      {nextNote && (
        <a href={`/note/${nextNote.id}`} style="background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; text-decoration: none; display: flex; flex-direction: column; gap: 6px; text-align: right; transition: all 0.2s;">
          <span style="font-family: var(--mono); font-size: 11px; color: var(--muted); display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
            CATATAN BERIKUTNYA <span>&rarr;</span>
          </span>
          <span style="font-size: 13.5px; font-weight: 700; color: var(--heading); line-height: 1.4;">{nextNote.title}</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // Reading progress bar
  const progBar = document.getElementById('read-progress-bar');
  if (progBar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const pct = h > 0 ? (window.scrollY / h) * 100 : 0;
      progBar.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }, { passive: true });
  }

  // Quick In-Article Font Scaler
  document.querySelectorAll('.font-scaler-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const scale = btn.getAttribute('data-scale') || 'normal';
      document.documentElement.setAttribute('data-size', scale);
      localStorage.setItem('katakating_size', scale);
      document.querySelectorAll('.font-scaler-btn').forEach(b => {
        b.style.fontWeight = '500';
        b.style.color = 'var(--muted)';
      });
      btn.style.fontWeight = '700';
      btn.style.color = 'var(--heading)';
    });
  });

  // Global helper for copying code snippets in command panels
  window.copyCodeSnippet = function(button) {
    const panel = button.closest('.command-panel');
    if (!panel) return;
    const codeEl = panel.querySelector('code');
    if (!codeEl) return;
    const codeText = codeEl.innerText;

    navigator.clipboard.writeText(codeText).then(() => {
      const originalHtml = button.innerHTML;
      button.innerHTML = '<span>Tersalin!</span>';
      button.style.borderColor = '#22c55e';
      button.style.color = '#22c55e';
      setTimeout(() => {
        button.innerHTML = originalHtml;
        button.style.borderColor = '';
        button.style.color = '';
      }, 2000);
    });
  };

  // Share Article Button trigger
  const shareBtn = document.getElementById('btn-share-article');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const title = shareBtn.getAttribute('data-title') || document.title;
      const noteId = shareBtn.getAttribute('data-id') || '';
      const summary = shareBtn.getAttribute('data-summary') || '';
      const url = window.location.href;

      if (navigator.share && window.innerWidth <= 768) {
        navigator.share({
          title: title,
          text: `${title} — ${summary}`,
          url: url
        }).catch(() => {
          if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
        });
      } else {
        if (window.openShareModal) window.openShareModal({ title, id: noteId, url, summary });
      }
    });
  }

  // Quiz checkpoint interaction
  const quizBtns = document.querySelectorAll('.quiz-opt-btn');
  const quizFeedback = document.getElementById('quiz-feedback');
  quizBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      quizBtns.forEach(b => b.classList.remove('correct', 'wrong'));
      btn.classList.add('correct');
      if (quizFeedback) quizFeedback.style.display = 'block';
    });
  });
})();
</script>
