---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<header class="market-header" id="site-header">
  <div class="market-header-inner">
    <div class="market-brand">
      <a class="market-brand-home" href="/" aria-label="[>] KATAKATING home">
        <span class="brand-title">[&gt;] KATAKATING</span>
        <span class="brand-badge">KNOWLEDGE HUB</span>
      </a>
    </div>

    <nav class="market-nav" aria-label="Main navigation">
      <div class="market-nav-links">
        <a class={currentPath === '/' ? 'active nav-link-main' : 'nav-link-main'} href="/#catalog" aria-label="Semua Catatan">Semua Catatan</a>
        <a class={currentPath === '/upload' ? 'active nav-link-upload' : 'nav-link-upload'} href="/upload" aria-label="Upload Catatan">Upload</a>
        <button type="button" class="nav-link-request" id="header-open-request-btn" aria-label="Minta Materi">
          <span>Minta Materi</span>
          <span style="font-family: var(--mono); font-size: 10px; background: var(--accent-dim); color: var(--accent); padding: 1px 5px; border-radius: 4px; border: 1px solid var(--line);">REQ</span>
        </button>
        <a class={currentPath.includes('/note/panduan-kontribusi') ? 'active nav-link-panduan' : 'nav-link-panduan'} href="/note/panduan-kontribusi" aria-label="Panduan Kontribusi">Panduan</a>
        <a class={currentPath === '/graph' ? 'active market-icon-link' : 'market-icon-link'} href="/graph" title="Graf Pengetahuan (The Brain)" aria-label="Graf Pengetahuan (The Brain)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="3"/><circle cx="5" cy="19" r="3"/><circle cx="19" cy="19" r="3"/><path d="M12 8v4"/><path d="m7.5 16.5 2.5-3.5"/><path d="m16.5 16.5-2.5-3.5"/></svg>
        </a>
        <a class="market-icon-link" href="https://github.com/muadzhdz/katakating" target="_blank" rel="noreferrer" title="Repositori GitHub" aria-label="Repositori GitHub">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span class="nav-ext-arrow">↗</span>
        </a>
      </div>

      <div class="market-nav-actions">
        <div id="auth-nav-container" class="auth-nav-slot"></div>
        
        <!-- Settings / Theme Center Button -->
        <button class="square-action" id="settings-toggle-btn" type="button" aria-label="Pengaturan Tampilan (Tema &amp; Font)" title="Pengaturan Tampilan (Tema &amp; Font)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </button>

        <!-- Quick Theme Toggle Button (Silent) -->
        <button class="square-action" id="theme-toggle" type="button" aria-label="Ganti Tema Cepat" title="Ganti Mode Terang/Gelap">
          <!-- Injected by main.js updateThemeIcon -->
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <button class="mobile-menu-btn" id="mobile-menu-btn" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-nav-panel">
          <svg class="icon-menu-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg class="icon-menu-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- COLLAPSIBLE MOBILE NAV PANEL -->
  <div class="mobile-nav-panel" id="mobile-nav-panel" hidden>
    <div class="mobile-nav-inner">
      <div class="mobile-nav-section-title">// NAVIGASI UTAMA</div>
      <a href="/#catalog" class="mobile-nav-item">
        <span class="mobile-nav-num">[01]</span>
        <span class="mobile-nav-label">Semua Catatan</span>
      </a>
      <a href="/upload" class="mobile-nav-item">
        <span class="mobile-nav-num">[02]</span>
        <span class="mobile-nav-label">Upload Catatan</span>
      </a>
      <button type="button" class="mobile-nav-item" id="mobile-open-request-btn" style="background: none; border: none; width: 100%; text-align: left; cursor: pointer;">
        <span class="mobile-nav-num">[03]</span>
        <span class="mobile-nav-label">Minta Materi (Wishlist)</span>
      </button>
      <a href="/note/panduan-kontribusi" class="mobile-nav-item">
        <span class="mobile-nav-num">[04]</span>
        <span class="mobile-nav-label">Panduan Kontribusi</span>
      </a>
      <a href="/graph" class="mobile-nav-item">
        <span class="mobile-nav-num">[05]</span>
        <span class="mobile-nav-label">Graf Pengetahuan (The Brain)</span>
      </a>
      <button type="button" class="mobile-nav-item" id="mobile-open-settings-btn" style="background: none; border: none; width: 100%; text-align: left; cursor: pointer;">
        <span class="mobile-nav-num">[06]</span>
        <span class="mobile-nav-label">Pengaturan Tampilan (Tema &amp; Huruf)</span>
      </button>
      <div class="mobile-nav-divider"></div>
      <div class="mobile-nav-section-title">// TAUTAN EKSTERNAL</div>
      <a href="https://github.com/muadzhdz/katakating" target="_blank" rel="noreferrer" class="mobile-nav-item mobile-nav-ext">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        <span>Repositori GitHub</span>
        <span class="mobile-nav-arrow">↗</span>
      </a>
    </div>
  </div>
</header>

<style>
.nav-link-request {
  background: transparent;
  border: none;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  padding: 6px 10px;
  border-radius: var(--radius);
  transition: all var(--t-fast) var(--ease-out);
}
.nav-link-request:hover {
  background: var(--line-soft);
  color: var(--heading);
}
</style>

<script is:inline>
(function() {
  const reqBtn = document.getElementById('header-open-request-btn');
  const mobReqBtn = document.getElementById('mobile-open-request-btn');
  const settingsBtn = document.getElementById('settings-toggle-btn');
  const mobSettingsBtn = document.getElementById('mobile-open-settings-btn');

  if (reqBtn) reqBtn.addEventListener('click', () => { if (window.openRequestDrawer) window.openRequestDrawer(); });
  if (mobReqBtn) mobReqBtn.addEventListener('click', () => { 
    const p = document.getElementById('mobile-nav-panel');
    if (p) p.hidden = true;
    if (window.openRequestDrawer) window.openRequestDrawer(); 
  });

  if (settingsBtn) settingsBtn.addEventListener('click', () => { if (window.openSettingsModal) window.openSettingsModal(); });
  if (mobSettingsBtn) mobSettingsBtn.addEventListener('click', () => {
    const p = document.getElementById('mobile-nav-panel');
    if (p) p.hidden = true;
    if (window.openSettingsModal) window.openSettingsModal();
  });
})();
</script>
