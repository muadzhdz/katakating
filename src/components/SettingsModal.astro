---
// src/components/SettingsModal.astro
---

<div id="settings-modal" class="settings-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="settings-title">
  <div class="settings-modal-card">
    <!-- MODAL HEADER -->
    <div class="settings-modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="display: inline-block; width: 6px; height: 14px; background: var(--accent); border-radius: 2px;"></span>
        <h3 id="settings-title" class="settings-modal-title">// PENGATURAN TAMPILAN &amp; TIPOGRAFI</h3>
      </div>
      <button type="button" class="square-action" id="close-settings-btn" aria-label="Tutup Pengaturan" style="width: 28px; height: 28px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="settings-modal-body">
      <!-- 1. THEMES SECTION -->
      <div class="settings-group">
        <label class="settings-label">
          <span>TEMA WARNA (16 PALET OMARCHY SUITE)</span>
          <span style="font-size: 10px; color: var(--muted); font-weight: 500;">INSTANT APPLIED</span>
        </label>

        <!-- SUBSECTION: OLED & DARK PALETTES -->
        <div style="font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 10px 0 6px;">
          // PALET GELAP &amp; OLED
        </div>
        <div class="theme-swatches-grid" id="theme-swatches-dark">
          <!-- 1. Vantablack -->
          <button type="button" class="theme-swatch-btn" data-theme-val="vantablack" title="Vantablack (OLED Pure)">
            <div class="theme-swatch-preview" style="background: #090a0d;">
              <span style="flex: 1; background: #ffffff;"></span>
              <span style="flex: 2; background: #111318;"></span>
            </div>
            <span class="theme-swatch-name">Vantablack</span>
          </button>

          <!-- 2. Tokyo Night -->
          <button type="button" class="theme-swatch-btn" data-theme-val="tokyo-night" title="Tokyo Night (Midnight Cyber)">
            <div class="theme-swatch-preview" style="background: #1a1b26;">
              <span style="flex: 1; background: #7aa2f7;"></span>
              <span style="flex: 2; background: #202336;"></span>
            </div>
            <span class="theme-swatch-name">Tokyo Night</span>
          </button>

          <!-- 3. Catppuccin Mocha -->
          <button type="button" class="theme-swatch-btn" data-theme-val="catppuccin" title="Catppuccin Mocha (Lavender Pastel)">
            <div class="theme-swatch-preview" style="background: #1e1e2e;">
              <span style="flex: 1; background: #cba6f7;"></span>
              <span style="flex: 2; background: #252538;"></span>
            </div>
            <span class="theme-swatch-name">Catppuccin</span>
          </button>

          <!-- 4. Nord Arctic -->
          <button type="button" class="theme-swatch-btn" data-theme-val="nord" title="Nord Arctic (Frosty Slate)">
            <div class="theme-swatch-preview" style="background: #2e3440;">
              <span style="flex: 1; background: #88c0d0;"></span>
              <span style="flex: 2; background: #3b4252;"></span>
            </div>
            <span class="theme-swatch-name">Nord Arctic</span>
          </button>

          <!-- 5. Gruvbox Dark -->
          <button type="button" class="theme-swatch-btn" data-theme-val="gruvbox" title="Gruvbox Dark (Retro Earth)">
            <div class="theme-swatch-preview" style="background: #282828;">
              <span style="flex: 1; background: #fabd2f;"></span>
              <span style="flex: 2; background: #32302f;"></span>
            </div>
            <span class="theme-swatch-name">Gruvbox Dark</span>
          </button>

          <!-- 6. Rosé Pine -->
          <button type="button" class="theme-swatch-btn" data-theme-val="rose-pine" title="Rosé Pine (Moody Violet)">
            <div class="theme-swatch-preview" style="background: #191724;">
              <span style="flex: 1; background: #ebbcba;"></span>
              <span style="flex: 2; background: #211f30;"></span>
            </div>
            <span class="theme-swatch-name">Rosé Pine</span>
          </button>

          <!-- 7. Everforest -->
          <button type="button" class="theme-swatch-btn" data-theme-val="everforest" title="Everforest (Organic Pine)">
            <div class="theme-swatch-preview" style="background: #272e33;">
              <span style="flex: 1; background: #a7c080;"></span>
              <span style="flex: 2; background: #2f383e;"></span>
            </div>
            <span class="theme-swatch-name">Everforest</span>
          </button>

          <!-- 8. Kanagawa -->
          <button type="button" class="theme-swatch-btn" data-theme-val="kanagawa" title="Kanagawa (Samurai Gold)">
            <div class="theme-swatch-preview" style="background: #1f1f28;">
              <span style="flex: 1; background: #c5a971;"></span>
              <span style="flex: 2; background: #2a2a37;"></span>
            </div>
            <span class="theme-swatch-name">Kanagawa</span>
          </button>

          <!-- 9. Dracula -->
          <button type="button" class="theme-swatch-btn" data-theme-val="dracula" title="Dracula (Gothic Pink & Violet)">
            <div class="theme-swatch-preview" style="background: #282a36;">
              <span style="flex: 1; background: #ff79c6;"></span>
              <span style="flex: 2; background: #343746;"></span>
            </div>
            <span class="theme-swatch-name">Dracula</span>
          </button>

          <!-- 10. Monokai Pro -->
          <button type="button" class="theme-swatch-btn" data-theme-val="monokai" title="Monokai Pro (Charcoal & Amber)">
            <div class="theme-swatch-preview" style="background: #222222;">
              <span style="flex: 1; background: #ffd866;"></span>
              <span style="flex: 2; background: #2d2a2e;"></span>
            </div>
            <span class="theme-swatch-name">Monokai Pro</span>
          </button>

          <!-- 11. Solarized Dark -->
          <button type="button" class="theme-swatch-btn" data-theme-val="solarized-dark" title="Solarized Dark (Teal Abyss)">
            <div class="theme-swatch-preview" style="background: #002b36;">
              <span style="flex: 1; background: #2aa198;"></span>
              <span style="flex: 2; background: #073642;"></span>
            </div>
            <span class="theme-swatch-name">Solarized</span>
          </button>

          <!-- 12. Cyber Emerald -->
          <button type="button" class="theme-swatch-btn" data-theme-val="cyber-emerald" title="Cyber Emerald (Neon Matrix)">
            <div class="theme-swatch-preview" style="background: #070b09;">
              <span style="flex: 1; background: #00ff66;"></span>
              <span style="flex: 2; background: #0d1712;"></span>
            </div>
            <span class="theme-swatch-name">Cyber Emerald</span>
          </button>
        </div>

        <!-- SUBSECTION: DAYLIGHT & LIGHT PALETTES -->
        <div style="font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 16px 0 6px;">
          // PALET TERANG &amp; PAPER
        </div>
        <div class="theme-swatches-grid" id="theme-swatches-light">
          <!-- 13. Flexoki Light -->
          <button type="button" class="theme-swatch-btn" data-theme-val="flexoki-light" title="Flexoki Light (Paper Minimalist)">
            <div class="theme-swatch-preview" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.15);">
              <span style="flex: 1; background: #18181b;"></span>
              <span style="flex: 2; background: #f4f4f5;"></span>
            </div>
            <span class="theme-swatch-name">Flexoki Light</span>
          </button>

          <!-- 14. Catppuccin Latte -->
          <button type="button" class="theme-swatch-btn" data-theme-val="catppuccin-latte" title="Catppuccin Latte (Soft Pastel)">
            <div class="theme-swatch-preview" style="background: #eff1f5; border: 1px solid rgba(136,57,239,0.2);">
              <span style="flex: 1; background: #8839ef;"></span>
              <span style="flex: 2; background: #e6e9ef;"></span>
            </div>
            <span class="theme-swatch-name">Catppuccin Latte</span>
          </button>

          <!-- 15. Gruvbox Light -->
          <button type="button" class="theme-swatch-btn" data-theme-val="gruvbox-light" title="Gruvbox Light (Vintage Parchment)">
            <div class="theme-swatch-preview" style="background: #fbf1c7; border: 1px solid rgba(181,118,20,0.25);">
              <span style="flex: 1; background: #b57614;"></span>
              <span style="flex: 2; background: #f2e5bc;"></span>
            </div>
            <span class="theme-swatch-name">Gruvbox Light</span>
          </button>

          <!-- 16. Rosé Pine Dawn -->
          <button type="button" class="theme-swatch-btn" data-theme-val="rose-pine-dawn" title="Rosé Pine Dawn (Blush Morning)">
            <div class="theme-swatch-preview" style="background: #faf4ed; border: 1px solid rgba(215,130,126,0.25);">
              <span style="flex: 1; background: #d7827e;"></span>
              <span style="flex: 2; background: #f2e9de;"></span>
            </div>
            <span class="theme-swatch-name">Rosé Dawn</span>
          </button>
        </div>
      </div>

      <!-- 2. TYPOGRAPHY PRESETS -->
      <div class="settings-group">
        <label class="settings-label">
          <span>JENIS HURUF (7 TIPOGRAFI KURASI)</span>
          <span style="font-size: 10px; color: var(--muted); font-weight: 500;">WEB-SAFE FONTS</span>
        </label>
        <div class="settings-pills" id="font-pills">
          <button type="button" class="settings-pill-btn" data-font-val="sans" style="font-family: 'Inter', sans-serif;">
            <span>Modern Sans</span>
            <span class="pill-sub">Inter Variable // Standar UI</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="jakarta" style="font-family: 'Plus Jakarta Sans', sans-serif;">
            <span>Plus Jakarta</span>
            <span class="pill-sub">Geometric // Segar &amp; Bersih</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="space" style="font-family: 'Space Grotesk', sans-serif;">
            <span>Space Grotesk</span>
            <span class="pill-sub">Tech Brutalist // Karakter Kuat</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="jetbrains" style="font-family: 'JetBrains Mono', monospace;">
            <span>JetBrains Mono</span>
            <span class="pill-sub">Developer Terminal // Hacker</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="fira" style="font-family: 'Fira Code', monospace;">
            <span>Fira Code</span>
            <span class="pill-sub">Monospace // Presisi Kode</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="serif" style="font-family: 'Source Serif 4', serif;">
            <span>Editorial Serif</span>
            <span class="pill-sub">Source Serif 4 // Nyaman Baca</span>
          </button>

          <button type="button" class="settings-pill-btn" data-font-val="newsreader" style="font-family: 'Newsreader', serif;">
            <span>Newsreader Serif</span>
            <span class="pill-sub">Textbook // Standar Akademik</span>
          </button>
        </div>
      </div>

      <!-- 3. SCALE / UKURAN TEKS -->
      <div class="settings-group">
        <label class="settings-label">
          <span>SKALA UKURAN BACA</span>
        </label>
        <div class="settings-pills" id="size-pills">
          <button type="button" class="settings-pill-btn" data-size-val="compact" style="flex: 1; text-align: center;">
            <span>Ringkas (14.5px)</span>
            <span class="pill-sub">Kepadatan Tinggi</span>
          </button>
          <button type="button" class="settings-pill-btn" data-size-val="normal" style="flex: 1; text-align: center;">
            <span>Normal (16px)</span>
            <span class="pill-sub">Standar Default</span>
          </button>
          <button type="button" class="settings-pill-btn" data-size-val="large" style="flex: 1; text-align: center;">
            <span>Besar (17.5px)</span>
            <span class="pill-sub">Maksimal Kenyamanan</span>
          </button>
        </div>
      </div>

      <!-- 4. LIVE PREVIEW CARD -->
      <div class="settings-preview-box">
        <div class="settings-preview-label">// PRATINJAU LANGSUNG (LIVE SAMPLE)</div>
        <div class="settings-preview-title">Format Laporan Praktikum &amp; Analisis Kerumitan Algoritma</div>
        <div class="settings-preview-text">
          Standar penulisan naskah akademik Universitas Boash menggunakan margin 4-4-3-3 dengan struktur pembahasan berbasis first principles.
        </div>
      </div>

      <!-- RESET BUTTON -->
      <div style="display: flex; justify-content: flex-end; margin-top: 18px;">
        <button type="button" id="reset-settings-btn" class="button" style="min-height: 30px; font-size: 11px; background: transparent; border: 1px solid var(--line);">
          Kembalikan ke Default (Vantablack + Inter)
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const modal = document.getElementById('settings-modal');
  const closeBtn = document.getElementById('close-settings-btn');
  const resetBtn = document.getElementById('reset-settings-btn');
  if (!modal) return;

  const lightThemes = ['flexoki-light', 'light', 'catppuccin-latte', 'gruvbox-light', 'rose-pine-dawn'];

  function syncActiveControls() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'vantablack';
    const currentFont = document.documentElement.getAttribute('data-font') || 'sans';
    const currentSize = document.documentElement.getAttribute('data-size') || 'normal';

    // Theme swatches
    document.querySelectorAll('.theme-swatch-btn').forEach(btn => {
      const val = btn.getAttribute('data-theme-val');
      const isMatch = (val === currentTheme) || 
                      (val === 'vantablack' && currentTheme === 'dark') ||
                      (val === 'flexoki-light' && currentTheme === 'light') ||
                      (val === 'jetbrains' && currentTheme === 'mono');
      btn.classList.toggle('active', isMatch);
    });

    // Font pills
    document.querySelectorAll('#font-pills .settings-pill-btn').forEach(btn => {
      const val = btn.getAttribute('data-font-val');
      const isMatch = (val === currentFont) || (val === 'jetbrains' && currentFont === 'mono');
      btn.classList.toggle('active', isMatch);
    });

    // Size pills
    document.querySelectorAll('#size-pills .settings-pill-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-size-val') === currentSize);
    });
  }

  // Theme click listener
  document.querySelectorAll('.theme-swatch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const themeVal = btn.getAttribute('data-theme-val');
      document.documentElement.setAttribute('data-theme', themeVal);
      
      if (lightThemes.indexOf(themeVal) !== -1) {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
      
      localStorage.setItem('katakating_theme', themeVal);
      localStorage.setItem('omarchy_theme', themeVal);
      syncActiveControls();
      window.dispatchEvent(new CustomEvent('katakating-theme-change', { detail: { theme: themeVal } }));
    });
  });

  // Font click listener
  document.querySelectorAll('#font-pills .settings-pill-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const fontVal = btn.getAttribute('data-font-val');
      document.documentElement.setAttribute('data-font', fontVal);
      localStorage.setItem('katakating_font', fontVal);
      syncActiveControls();
    });
  });

  // Size click listener
  document.querySelectorAll('#size-pills .settings-pill-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sizeVal = btn.getAttribute('data-size-val');
      document.documentElement.setAttribute('data-size', sizeVal);
      localStorage.setItem('katakating_size', sizeVal);
      syncActiveControls();
    });
  });

  // Reset to Defaults
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      document.documentElement.setAttribute('data-theme', 'vantablack');
      document.documentElement.classList.remove('light');
      document.documentElement.setAttribute('data-font', 'sans');
      document.documentElement.setAttribute('data-size', 'normal');
      localStorage.setItem('katakating_theme', 'vantablack');
      localStorage.setItem('katakating_font', 'sans');
      localStorage.setItem('katakating_size', 'normal');
      syncActiveControls();
    });
  }

  // Close modal
  function closeModal() {
    modal.classList.remove('open');
  }
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    // Shortcut 'T' to toggle settings
    if (e.key.toLowerCase() === 't' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
      e.preventDefault();
      if (modal.classList.contains('open')) {
        closeModal();
      } else {
        window.openSettingsModal && window.openSettingsModal();
      }
    }
  });

  // Global trigger
  window.openSettingsModal = function() {
    syncActiveControls();
    modal.classList.add('open');
  };

  syncActiveControls();
})();
</script>
